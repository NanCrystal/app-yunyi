/* pages/comments/comments.wxss */

/* ============================================================
   留言墙 - Dark Space 极简黑色主题 + 漂浮气泡动画
   ============================================================ */

/* ── 页面容器 ── */
.comment-page {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: #000000; /* 纯黑背景模拟深空 */
  z-index: 1;
}

/* ── 顶部返回按钮 ── */
.back-btn {
  position: fixed;
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  /* background: rgba(255, 255, 255, 0.08); */
  /* border: 2rpx solid rgba(255, 255, 255, 0.15); */
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 60;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.5);
  transition: all 0.25s ease;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.9;
  transform: rotateY(180deg);
}

.back-btn-hover {
  transform: scale(0.9);
  /* background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.3); */
}

/* ============================================================
   区块1: 漂浮气泡层
   ============================================================ */
.bubbles-layer {
  position: absolute;
  inset: 0;
  pointer-events: none; /* 让点击穿透到下层 */
}

/* ── 单个气泡节点 ── */
.bubble {
  position: absolute;
  display: inline-flex;
  align-items: center;
  top: var(--start-y); /* 使用 CSS 自定义属性设置起始Y位置 */
  animation: floatUp linear infinite both; /* 无限循环匀速上升动画 */
  opacity: 0; /* 初始透明，由动画控制淡入 */
  transform-origin: center center;
  white-space: nowrap; /* 防止文字换行 */
  pointer-events: auto; /* 气泡本身可交互 */
}

/* floatUp 关键帧动画定义 (4阶段) */
@keyframes floatUp {
  0% {
    opacity: 0; /* 完全透明 - 准备期 */
    transform: translateY(0);
  }
  5% {
    opacity: 1; /* 快速淡入完成 - 完全可见 */
  }
  90% {
    opacity: 1; /* 持续上升阶段 - 保持可见 */
  }
  100% {
    opacity: 0; /* 末端淡出消失 */
    transform: translateY(var(--end-y)); /* 使用自定义属性控制终点 */
  }
}

/* 气泡文字样式 */
.bubble-text {
  white-space: nowrap;
  letter-spacing: 0.3px;
  text-shadow: 0 0 8px currentColor; /* 霓虹发光效果 */
}

/* ============================================================
   区块2: 悬浮消息按钮
   ============================================================ */
.msg-btn {
  position: fixed;
  right: 20rpx;
  bottom: 30rpx; /* 距离底部30rpx（按需求） */
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08); /* 半透明暗色背景 */
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.25s ease;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.5);
}

.msg-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.9;
}

/* 点击反馈动效 */
.msg-btn-hover {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.3);
}

/* ============================================================
   区块3: 输入面板 (从右侧滑入)
   ============================================================ */
.input-panel-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6); /* 半透明遮罩 */
  display: flex;
  align-items: center;
  justify-content: flex-end; /* 内容靠右对齐 */
  padding: 0 24rpx;
  z-index: 100;
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 输入面板容器 - 胶囊圆角玻璃拟态 */
.input-panel {
  width: 85%;
  max-width: 600rpx;
  background: rgba(20, 20, 20, 0.92); /* 半透明深色背景 */
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50rpx; /* 胶囊形状 */
  padding: 16rpx 20rpx 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.6),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20rpx); /* 毛玻璃效果（iOS支持较好） */
  animation: slideInRight 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* 从右向左滑入动画 */
@keyframes slideInRight {
  from {
    transform: translateX(120%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

/* 输入框样式 */
.input-field {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 28rpx;
  color: #cccccc;
  background: transparent;
  border: none;
  outline: none;
}

.input-placeholder {
  color: #666666;
  font-size: 28rpx;
}

/* 发送按钮 */
.send-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  background: transparent;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.send-icon {
  font-size: 24rpx;
  margin-top: 2rpx;
}

.send-btn-hover:not(.disabled) {
  background: rgba(108, 99, 255, 0.2); /* 主色调悬停反馈 */
  border-color: #6C63FF;
  transform: scale(1.05);
}

/* 禁用状态 */
.send-btn.disabled {
  opacity: 0.3;
  pointer-events: none;
}

/* ============================================================
   区块4: 聚光灯层（新留言高亮展示）
   ============================================================ */
.spotlight-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50; /* 高于气泡层，低于输入面板(100) */
  pointer-events: none; /* 不阻挡底层交互 */
  animation: spotLightPulse 3s ease-out forwards;
}

.spotlight-text {
  max-width: 80%;
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  text-align: center;
  white-space: nowrap;
  letter-spacing: 2px;
  text-shadow:
    0 0 20px rgba(108, 99, 255, 0.9),
    0 0 40px rgba(108, 99, 255, 0.6),
    0 0 80px rgba(0, 212, 255, 0.4);
}

/** 聚光灯关键帧动画：弹性放大 + 呼吸闪烁 + 淡出消失（总时长3秒） */
@keyframes spotLightPulse {
  0% {
    opacity: 0;
    transform: scale(0.3) translateY(30rpx);
    filter: blur(8px);
  }
  15% {
    opacity: 1;
    transform: scale(1.2) translateY(0);
    filter: blur(0);
  }
  30% {
    opacity: 0.5;
    transform: scale(0.95) translateY(-4rpx);
    filter: blur(1px);
  }
  45% {
    opacity: 1;
    transform: scale(1.08) translateY(0);
    filter: blur(0);
  }
  60% {
    opacity: 0.55;
    transform: scale(1) translateY(2rpx);
    filter: blur(1px);
  }
  72% {
    opacity: 1;
    transform: scale(1.03) translateY(0);
    filter: blur(0);
  }
  85% {
    opacity: 0.95;
    transform: scale(1) translateY(0);
    filter: blur(0);
  }
  93% {
    opacity: 0.7;
    transform: scale(0.98) translateY(-2rpx);
    filter: blur(2px);
  }
  100% {
    opacity: 0;
    transform: scale(0.9) translateY(-10rpx);
    filter: blur(6px);
  }
}

/* ============================================================
   区块5: 登录弹窗（新版 - 头像选择 + 昵称输入）
   ============================================================ */

.login-popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  animation: fadeIn 0.25s ease forwards;
}

.login-popup {
  width: 600rpx;
  background: #1a1a2e;
  border-radius: 32rpx;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow:
    0 20rpx 80rpx rgba(0, 0, 0, 0.6),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.login-popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.login-popup-subtitle {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 44rpx;
}

/* 头像选择按钮 */
.avatar-picker-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 4rpx solid rgba(108, 99, 255, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.avatar-picker-btn::after {
  border: none; /* 去除微信默认按钮边框 */
}

.login-avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #222233;
}

.avatar-hint {
  position: absolute;
  bottom: -36rpx;
  font-size: 20rpx;
  color: #6C63FF;
  white-space: nowrap;
}

/* 昵称输入框 */
.nickname-input-wrap {
  margin-top: 56rpx;
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #ffffff;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: transparent;
}

.nickname-placeholder {
  color: #666666;
  font-size: 28rpx;
}

/* 按钮区域 */
.login-popup-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
  width: 100%;
}

.login-cancel-btn,
.login-confirm-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-cancel-btn text,
.login-confirm-btn text {
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1px;
}

.login-cancel-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.login-cancel-btn text {
  color: #999999;
}

.login-confirm-btn {
  background: linear-gradient(135deg, #6C63FF 0%, #00D4FF 100%);
  border: none;
  transition: all 0.2s ease;
}

.login-confirm-btn text {
  color: #ffffff;
}

.login-confirm-btn:active:not(.disabled) {
  transform: scale(0.96);
  opacity: 0.9;
}

.login-confirm-btn.disabled {
  opacity: 0.3;
  pointer-events: none;
}
