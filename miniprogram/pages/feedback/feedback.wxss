/* pages/feedback/feedback.wxss */

.page {
  min-height: 100vh;
  background-color: #000000;
  overflow: hidden;
}
/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
  transform: rotateY(180deg);
}

.custom-nav-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
  text-transform: uppercase;
}
.feedback-container {
  padding: 0 32rpx;
  padding-bottom: 60rpx;
}

/* 头部标题 */
.header {
  padding: 20rpx 0 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

/* 版本信息 */
.version-info {
  display: flex;
  align-items: center;
  padding: 12rpx 0 24rpx;
}

.version-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #e74c3c;
  margin-right: 12rpx;
}

.version-text {
  font-size: 22rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

/* 页面标题 */
.page-title {
  padding: 24rpx 0 20rpx;
}

.page-title text {
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #262626;
  margin: 24rpx 0;
}

/* 表单区域 */
.form-section {
  margin-bottom: 16rpx;
  padding: 0 24rpx;
}

/* 区域标签 */
.section-label {
  display: flex;
  align-items: baseline;
  margin-bottom: 28rpx;
}

.section-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #e74c3c;
  margin-right: 8rpx;
}

.label-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

.required {
  color: #e74c3c;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.optional {
  color: #666666;
  font-size: 26rpx;
  margin-left: 4rpx;
}

/* 复选框组 - 一行三个对齐 */
.checkbox-group {
  display: flex;
  flex-wrap: wrap;
}

.checkbox-item {
  width: 33.33%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-right: 16rpx;
  margin-bottom: 24rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #444444;
  border-radius: 4rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background-color: #ffffff;
  border-color: #ffffff;
}

.check-icon {
  width: 20rpx;
  height: 12rpx;
  border-left: 3rpx solid #000000;
  border-bottom: 3rpx solid #000000;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.checkbox-label {
  font-size: 28rpx;
  color: #cccccc;
}

/* 文本输入框 */
.description-input {
  width: 100%;
  min-height: 200rpx;
  background-color: transparent;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.placeholder {
  color: #555555;
  font-size: 28rpx;
}

/* 上传区域 */
.upload-area {
  width: 100%;
  height: 320rpx;
  border: 2rpx dashed #333333;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  position: relative;
  width: 80rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}

.camera-body {
  width: 80rpx;
  height: 56rpx;
  border: 3rpx solid #666666;
  border-radius: 8rpx;
  position: absolute;
  bottom: 0;
}

.camera-body::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 12rpx;
  border: 3rpx solid #666666;
  border-bottom: none;
  border-radius: 15rpx 15rpx 0 0;
  background: transparent;
}

.camera-lens {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #666666;
  border-radius: 50%;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
}

.camera-lens::after {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background-color: #666666;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.upload-text {
  font-size: 26rpx;
  color: #666666;
}

.preview-image {
  width: 100%;
  height: 100%;
}

/* 联系方式输入框 */
.contact-input {
  width: 100%;
  height: 88rpx;
  background-color: transparent;
  color: #ffffff;
  font-size: 28rpx;
  border-bottom: 1rpx solid #222222;
  padding: 0;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-wrapper {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background-color: transparent;
  border: 2rpx solid #444444;
  border-radius: 48rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.7;
}
