/* pages/home-detail/home-detail.wxss */
.detail-page {
  min-height: 100vh;
  background-color: #000000;
  padding: 60rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-title {
  font-size: 44rpx;
  font-weight: 500;
  color: #ffffff;
  text-align: center;
  letter-spacing: 4rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.detail-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  margin-bottom: 40rpx;
}

.detail-cover {
  width: 100%;
  max-width: 600rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}

.detail-content {
  width: 100%;
  max-width: 640rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 2;
  text-align: justify;
}
