.page {
  height: 100%;
  background-color: #000000;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
  transform: rotateY(180deg);
}

.custom-nav-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
  text-transform: uppercase;
}

/* ===== 筛选面板 - 顶部弹出 ===== */
.filter-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.65s ease, visibility 0.15s ease;
}

.filter-overlay--show {
  opacity: 1;
  visibility: visible;
}

.filter-dropdown {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  transform: translateY(-100%);
  transition: transform 0.8s cubic-bezier(0.32, 0.72, 0, 1);
}

.filter-dropdown--show {
  transform: translateY(0);
}

.filter-panel {
  background-color: #141414;
  border-bottom: 1px solid #262626;
  padding: 24rpx 48rpx;
  border-radius: 0 0 20rpx 20rpx;
}

/* 筛选面板底部操作按钮 */
.filter-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 24rpx 48rpx;
  /* padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); */
  /* background-color: #1a1a1a; */
}

.filter-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.filter-btn text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.filter-btn--reset {
  border: 1rpx solid #444444;
}

.filter-btn--reset text {
  color: #999999;
}

.filter-btn--confirm {
  background-color: var(--theme);
}

.filter-btn--confirm text {
  color: #000000;
}

.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  width: 120rpx;
  flex-shrink: 0;
}

.filter-tags-inline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.filter-tag {
  padding: 8rpx 24rpx;
  border: 1px solid #262626;
  background: transparent;
}

.filter-tag text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #999999;
  letter-spacing: 2rpx;
}

.filter-tag--active {
  background-color: var(--theme);
  border-color: var(--theme);
}

.filter-tag--active text {
  color: #ffffff;
}

/* ===== 统计栏 ===== */
.count-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  border-bottom: 1px solid #262626;
}
.count-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
/* 筛选图标按钮 */
.filter-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.7;
}
.count-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 2rpx;
}

.count-num {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ===== 照片内容 ===== */
.photos-content {
  padding: 32rpx 0;
}

.month-group {
  margin-bottom: 48rpx;
}

.month-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 12rpx 24rpx;
  border-bottom: 1px solid #262626;
  margin-bottom: 24rpx;
}
.month-header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.month-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.month-count {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #666666;
  letter-spacing: 2rpx;
}

.day-group {
  margin-bottom: 24rpx;
}

.day-header {
  display: flex;
  flex-direction: row;
  padding: 0 12rpx 24rpx;
  align-items: center;
}

.day-checkbox-wrap {
  margin-right: 12rpx;
  padding: 4rpx 0;
}

.day-title {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: var(--theme);
  letter-spacing: 4rpx;

  /* margin-bottom: 16rpx; */
}

/* ===== 照片网格（4列统一正方形）===== */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.photo-item {
  aspect-ratio: 1;
  overflow: hidden;
  position: relative;
}

.photo-img {
  width: 100%;
  height: 100%;
  /* filter: grayscale(1); */
  opacity: 0;
  transition: opacity 0.25s ease;
}

.photo-img--visible {
  opacity: 1;
}

.photo-check {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  z-index: 1;
  padding: 8rpx;
}

.photo-check-box {
  width: 32rpx;
  height: 32rpx;
  border: 1px solid #666666;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-check-box--active {
  border-color: var(--theme);
  background-color: var(--theme);
}

.photo-check-mark {
  color: #ffffff;
  font-size: 24rpx;
}

/* ===== 通用复选框样式（月份/日期） ===== */
.checkbox-wrap {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  vertical-align: middle;
}

.checkbox-wrap--inline {
  display: inline-flex;
  margin-right: 8rpx;
}

.checkbox-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #666666;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.checkbox-box--small {
  width: 28rpx;
  height: 28rpx;
  border-width: 1.5rpx;
}

.checkbox-box--active {
  border-color: var(--theme);
  background-color: var(--theme);
}

.check-mark {
  color: #000000;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
}

.check-mark--small {
  font-size: 18rpx;
}

/* ===== 底部浮动统计栏 ===== */
.selection-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: linear-gradient(
    to top,
    rgba(20, 20, 20, 0.98),
    rgba(20, 20, 20, 0.95)
  );
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  transform: translateY(100%);
  opacity: 0;
  visibility: hidden;
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.25s ease,
    visibility 0.25s ease;
}

.selection-bar--visible {
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
}

.selection-count {
  font-family: "Courier New", Courier, monospace;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 2rpx;
}

.selection-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.btn-download,
.btn-cancel {
  padding: 14rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-download {
  background-color: var(--theme);
  border-radius: 8rpx;
}

.btn-download text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--theme);
  letter-spacing: 2rpx;
}

.btn-cancel {
  border: 1rpx solid #444444;
  border-radius: 8rpx;
}

.btn-cancel text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  color: #999999;
  letter-spacing: 2rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  border: 1px dashed #262626;
}

/* ===== 加载状态 ===== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
}

.loading-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.4;
  }
  50% {
    opacity: 1;
  }
}

.empty-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  text-align: center;
}

/* ===== 全屏预览 ===== */
.preview-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background-color: #000000;
  display: flex;
  flex-direction: column;
}

.preview-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 40rpx;
  background: rgba(0, 0, 0, 0.8);
  z-index: 2;
}

.preview-close {
  width: 60rpx;
  height: 60rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
}

.preview-label {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #cccccc;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.preview-type-badge {
  padding: 4rpx 16rpx;
  border: 1px solid rgba(142, 216, 131, 0.3);
}

.preview-type-badge text {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--theme);
}

.preview-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.preview-img {
  max-width: 85vw;
  max-height: 60vh;
  border: 2rpx solid var(--theme);
}

.preview-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.preview-nav text {
  color: #ffffff;
  font-size: 48rpx;
}

.preview-nav--left {
  left: 32rpx;
}
.preview-nav--right {
  right: 32rpx;
}

.preview-counter {
  position: absolute;
  bottom: 32rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

.preview-counter text {
  font-family: "Courier New", Courier, monospace;
  font-size: 24rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
}

.preview-info {
  padding: 48rpx;
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0.95));
  border-top: 1px solid #1a1a1a;
}

.preview-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.preview-filename {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

.preview-date {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

.preview-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
  margin: 16rpx 0 12rpx;
}

.preview-desc {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: #cccccc;
  display: block;
  margin-bottom: 16rpx;
}

.preview-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.preview-tag {
  padding: 6rpx 20rpx;
  background-color: #1a1a1a;
  border: 1px solid #262626;
}

.preview-tag text {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.preview-tag--green {
  background-color: #000000;
  border-color: rgba(142, 216, 131, 0.2);
}

.preview-tag--green text {
  color: var(--theme);
}

.bottom-placeholder {
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 底部已加载完毕提示 ===== */
.end-tip {
  padding: 16rpx 0;
}

.end-tip-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #444444;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

/* ===== 月份骨架屏占位（未加载时显示） ===== */
.skeleton-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rpx;
}

.skeleton-item {
  aspect-ratio: 1;
  background-color: #1a1a1a;
  animation: shimmer 1.6s ease-in-out infinite;
}

@keyframes shimmer {
  0%,
  100% {
    opacity: 0.3;
  }
  50% {
    opacity: 0.6;
  }
}

/* ===== 月份加载中状态 ===== */
.month-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
  gap: 16rpx;
}

.month-loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #262626;
  border-top-color: var(--theme);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.month-loading-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
/* ===== 滚动条按钮（模拟真实滚动条）===== */
.drag-btn {
  position: fixed;
  right: 0;
  top: 20px;
  width: 40px;
  height: 40px;
  background-color: #1a1a1a;
  border-radius: 20rpx 0 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  opacity: 0;
  visibility: hidden;
  /* transform 由 JS 控制（GPU 合成层，不触发 layout） */
  will-change: transform;
  transition: opacity 0.2s ease, visibility 0.2s ease,
    width 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: -2rpx 4rpx 16rpx rgba(0, 0, 0, 0.6);
}

.drag-btn--visible {
  opacity: 1;
  visibility: visible;
}

.drag-btn--expanded {
  width: 300rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.drag-btn-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.drag-btn-date {
  flex: 1;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 20rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-right: 16rpx;
  text-align: center;
}

/* ===== 视频播放图标叠加层 ===== */
.play-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  pointer-events: none;
}

.play-icon {
  width: 64rpx;
  height: 64rpx;
  background-color: var(--theme);
  border-radius: 50%;
  opacity: 0.85;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.5));
  position: relative;
}

.play-icon::after {
  content: '';
  position: absolute;
  left: 55%;
  top: 50%;
  transform: translate(-40%, -50%);
  border-left: 22rpx solid white;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
}

/* ===== 无封面图时的渐变背景兜底 ===== */
.photo-item--no-cover {
  background: linear-gradient(135deg, #2a1a3e 0%, #1a2a4e 50%, #1a3a3a 100%);
}

.photo-item--no-cover .play-icon {
  opacity: 1;
  width: 80rpx;
  height: 80rpx;
}

/* ===== 视频处理状态提示 ===== */
.photo-item--not-ready {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.video-status {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 3;
}

.video-status-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #333333;
  border-top-color: #666666;
  border-radius: 50%;
  opacity: 0.4;
}

.video-status-spinner--active {
  opacity: 1;
  border-top-color: var(--theme, #8ed883);
  animation: spin 0.9s linear infinite;
}

.video-status-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  color: #666666;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ===== 大文件视频静态占位状态（无加载动画）===== */
.video-status--static {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.video-status-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.6;
}
