<!-- 自定义导航栏（fixed） -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="custom-nav-inner">
    <view class="custom-nav-left" bindtap="onGoBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="custom-nav-title">音频馆</text>
    <view class="custom-nav-right" />
  </view>
</view>
<view
  class="page"
  style="--theme: {{themeColor}}; --theme-r: {{themeR}}; --theme-g: {{themeG}}; --theme-b: {{themeB}}; padding-top: {{navBarHeight}}px;"
>
  <!-- 全屏播放器视图 -->
  <block wx:if="{{showNowPlaying && currentTrack}}">
    <view class="now-playing-mask">
      <view class="np-header">
        <view class="np-close" bind:tap="onCloseNowPlaying">
          <text>✕</text>
        </view>
        <text class="np-label">NOW PLAYING</text>
        <view class="np-share">
          <text>↗</text>
        </view>
      </view>
      <view class="np-body">
        <!-- 专辑封面 -->
        <view class="np-cover-wrap">
          <view class="np-cover-corners">
            <view class="np-corner np-corner--tl">
            </view>
            <view class="np-corner np-corner--tr">
            </view>
            <view class="np-corner np-corner--bl">
            </view>
            <view class="np-corner np-corner--br">
            </view>
          </view>
          <view class="np-cover">
            <image
              class="np-cover-img"
              src="../assets/images/1 (44).jpg"
              mode="aspectFill" />
          </view>
        </view>
        <!-- 元信息 -->
        <view class="np-meta">
          <text class="np-track-title">{{currentTrack.title}}</text>
          <view class="np-track-info">
            <text>{{currentTrack.author}}</text>
            <text class="np-dot">•</text>
            <text>{{currentTrack.date}}</text>
            <text class="np-dot">•</text>
            <view class="np-bitrate">
              <text>{{currentTrack.bitRate}}</text>
            </view>
          </view>
        </view>
        <!-- 播放控制 -->
        <view class="np-controls">
          <!-- 进度条 -->
          <view class="np-progress">
            <view class="np-progress-fill" style="width: {{isPlayingAudio ? '42%' : '1%'}};">
            </view>
            <view class="np-progress-dot" style="left: {{isPlayingAudio ? '42%' : '1%'}};">
            </view>
          </view>
          <!-- 时间 -->
          <view class="np-times">
            <text>{{isPlayingAudio ? '01:42' : '00:00'}}</text>
            <text>{{currentTrack.duration}}</text>
          </view>
          <!-- 按钮组 -->
          <view class="np-buttons">
            <view class="np-btn" bind:tap="onPrevTrack">
              <text>⏮</text>
            </view>
            <view class="np-btn np-btn--play" bind:tap="onTogglePlay">
              <text>{{isPlayingAudio ? '⏸' : '▶'}}</text>
            </view>
            <view class="np-btn" bind:tap="onNextTrack">
              <text>⏭</text>
            </view>
          </view>
        </view>
        <!-- 底部选项 -->
        <view class="np-options">
          <text>🔀</text>
          <text>🔁</text>
          <text>📋</text>
          <text>🔊</text>
        </view>
      </view>
      <view class="np-footer">
        <text>INDEXING ARCHIVE... 84% COMPLETE</text>
      </view>
    </view>
  </block>
  <!-- 音轨列表 -->
  <block wx:else>
    <view class="audio-container" style="height: calc(100vh - {{navBarHeight}}px;">
      <!-- 左侧月份导航（固定） -->
      <view class="month-nav">
        <view class="date-picker-year" bind:tap="onToggleYearPicker">
          <text class="year-text">{{currentYear}}</text>
          <text class="year-arrow">▼</text>
        </view>
        <text class="month-nav-label">ALL</text>
        <view
          wx:for="{{months}}"
          wx:key="value"
          class="month-nav-item {{currentMonth === item.value ? 'month-nav-item--active' : ''}}"
          data-month="{{item.value}}"
          bind:tap="onMonthTap"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
      <!-- 右侧内容区（独立滚动） -->
      <scroll-view class="audio-content" scroll-y enhanced show-scrollbar="{{false}}">
        <!-- <view class="audio-list-header">
          <text class="audio-list-title">音频库 / SOUND REGISTRY</text>
          <text class="audio-list-count">4 TRACKS</text>
        </view> -->
    <!-- 六月 -->
    <view class="audio-month">
      <view class="audio-month-title">
        <text>2026年06月</text>
      </view>
      <view class="audio-tracks">
        <view
          wx:for="{{juneTracks}}"
          wx:key="id"
          class="audio-track {{playingTrackId === item.id ? 'audio-track--active' : ''}}"
          data-id="{{item.id}}"
          bind:tap="onTrackRowTap"
        >
          <image
            class="audio-track-img"
            src="{{item.thumbnail}}"
            mode="aspectFill"
            lazy-load />
          <view class="audio-track-info">
            <text class="audio-track-name {{playingTrackId === item.id ? 'audio-track-name--active' : ''}}">{{item.title}}</text>
            <text class="audio-track-meta">{{item.author}} • {{item.bitRate}}</text>
          </view>
          <view
            class="audio-track-play"
            data-id="{{item.id}}"
            bind:tap="onTrackRowTap"
          >
            <text>{{playingTrackId === item.id && isPlayingAudio ? '⏸' : '▶'}}</text>
          </view>
        </view>
      </view>
    </view>
    <!-- 五月 -->
    <view class="audio-month">
      <view class="audio-month-title">
        <text>2026年05月</text>
      </view>
      <view class="audio-tracks">
        <view
          wx:for="{{mayTracks}}"
          wx:key="id"
          class="audio-track {{playingTrackId === item.id ? 'audio-track--active' : ''}}"
          data-id="{{item.id}}"
          bind:tap="onTrackRowTap"
        >
          <image
            class="audio-track-img"
            src="{{item.thumbnail}}"
            mode="aspectFill"
            lazy-load />
          <view class="audio-track-info">
            <text class="audio-track-name {{playingTrackId === item.id ? 'audio-track-name--active' : ''}}">{{item.title}}</text>
            <text class="audio-track-meta">{{item.author}} • {{item.bitRate}}</text>
          </view>
          <view
            class="audio-track-play"
            data-id="{{item.id}}"
            bind:tap="onTrackRowTap"
          >
            <text>{{playingTrackId === item.id && isPlayingAudio ? '⏸' : '▶'}}</text>
          </view>
        </view>
      </view>
    </view>
      </scroll-view>
    </view>
  </block>
  <view class="bottom-placeholder">
  </view>
</view>
<!-- 年份选择弹窗 -->
<view class="year-picker-mask {{showYearPicker ? 'year-picker-mask--show' : ''}}" catch:tap="onCloseYearPicker"></view>
<view class="year-picker {{showYearPicker ? 'year-picker--show' : ''}}">
  <view class="year-picker-header">
    <text class="year-picker-close" bind:tap="onCloseYearPicker">✕</text>
    <text class="year-picker-title">选择年份</text>
    <text class="year-picker-confirm" bind:tap="onConfirmYear">确定</text>
  </view>
  <picker-view
    value="{{[yearIndex]}}"
    bindchange="onYearScroll"
    indicator-style="height: 60rpx; border-top: 1px solid #333; border-bottom: 1px solid #333;"
    mask-style="background: transparent;"
    style="height: 280rpx; width: 100%; background: #000000;"
  >
    <picker-view-column>
      <view wx:for="{{yearRange}}" wx:key="*this" class="year-picker-item">{{item}}年</view>
    </picker-view-column>
  </picker-view>
</view>
<!-- 迷你播放器 -->
<view
  wx:if="{{!showNowPlaying && playingTrackId && currentTrack}}"
  class="mini-player safe-area-bottom"
  bind:tap="onMiniPlayerTap"
>
  <view class="mini-player-left">
    <image
      class="mini-player-img"
      src="{{currentTrack.thumbnail}}"
      mode="aspectFill" />
    <view class="mini-player-info">
      <text class="mini-player-title">{{currentTrack.title}}</text>
      <text class="mini-player-author">{{currentTrack.author}}</text>
    </view>
  </view>
  <view class="mini-player-controls">
    <view class="mini-player-btn" catch:tap="onPrevTrack">
      <text>⏮</text>
    </view>
    <view class="mini-player-btn" catch:tap="onTogglePlay">
      <text>{{isPlayingAudio ? '⏸' : '▶'}}</text>
    </view>
    <view class="mini-player-btn" catch:tap="onNextTrack">
      <text>⏭</text>
    </view>
  </view>
</view>
