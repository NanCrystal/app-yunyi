.page {
  min-height: 100vh;
  background-color: #000000;
}
/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  font-size: 48rpx;
  color: #ffffff;
  line-height: 1;
}

.custom-nav-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
}
/* ===== 列表视图 ===== */
.audio-container {
  display: flex;
  flex-direction: row;
}

.month-nav {
  width: 80rpx;
  flex-shrink: 0;
  border-right: 1px solid #262626;
  padding-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;
}

/* 年份选择器（缩小版） */
.date-picker-year {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border: 1px solid #333333;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.date-picker-year:active {
  opacity: 0.7;
}

.year-text {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
  font-weight: 400;
  color: #ffffff;
}

.year-arrow {
  font-size: 12rpx;
  color: #888888;
}

.month-nav-label {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  display: block;
  color: #555555;
  padding:12rpx 0 12rpx 12rpx;
  /* margin-bottom: 8rpx; */
  /* text-align: left; */
}

.month-nav-item {
  padding: 10rpx 0;
  margin-bottom: 2rpx;
}

.month-nav-item text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  color: #555555;
  display: block;
  padding:12rpx 0 12rpx 12rpx;
  text-align: left;
}

.month-nav-item--active text {
  color: #ff3333;
  font-weight: 600;
}

.audio-content {
  flex: 1;
  min-width: 0;
  height: 100%;
}
.audio-list-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding: 32rpx 48rpx 16rpx;
  border-bottom: 1px solid #262626;
}

.audio-list-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.audio-list-count {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #555555;
  text-transform: uppercase;
}

.audio-month {
  padding: 0 48rpx;
}

.audio-month-title {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 24rpx 0 12rpx;
  border-bottom: 1px solid #262626;
  background-color: #000000;
}

.audio-month-title text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.audio-tracks {
  display: flex;
  flex-direction: column;
}

.audio-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 16rpx;
  border-bottom: 1px solid #262626;
}

.audio-track-img {
  width: 100rpx;
  height: 100rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
  /* filter: grayscale(1); */
  opacity: 0.75;
}

.audio-track-info {
  flex: 1;
  min-width: 0;
}

.audio-track-name {
  display: block;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 26rpx;
  font-weight: 400;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.audio-track-name--active {
  color: var(--theme);
}

.audio-track-meta {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #777777;
  text-transform: uppercase;
}

.audio-track-play {
  width: 56rpx;
  height: 56rpx;
  border: 1px solid #262626;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #000000;
}

.audio-track-play text {
  color: #ffffff;
  font-size: 28rpx;
}

/* ===== 全屏播放器 ===== */
.now-playing-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background-color: #000000;
  display: flex;
  flex-direction: column;
}

.np-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 40rpx;
  background: rgba(0,0,0,0.8);
  border-bottom: 1px solid #262626;
}

.np-close {
  width: 56rpx;
  height: 56rpx;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.np-label {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.np-share {
  width: 56rpx;
  height: 56rpx;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.np-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  overflow-y: auto;
}

/* 专辑封面 */
.np-cover-wrap {
  position: relative;
  padding: 32rpx;
  border: 1px solid #262626;
  background-color: #050505;
}

.np-cover-corners {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.np-corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-color: #333333;
}

.np-corner--tl { top: -6rpx; left: -6rpx; border-top: 4rpx solid #333; border-left: 4rpx solid #333; }
.np-corner--tr { top: -6rpx; right: -6rpx; border-top: 4rpx solid #333; border-right: 4rpx solid #333; }
.np-corner--bl { bottom: -6rpx; left: -6rpx; border-bottom: 4rpx solid #333; border-left: 4rpx solid #333; }
.np-corner--br { bottom: -6rpx; right: -6rpx; border-bottom: 4rpx solid #333; border-right: 4rpx solid #333; }

.np-cover {
  width: 400rpx;
  height: 400rpx;
  overflow: hidden;
  border: 1px solid #262626;
}

.np-cover-img {
  width: 100%;
  height: 100%;
  filter: grayscale(1);
  opacity: 0.9;
}

/* 元信息 */
.np-meta {
  margin-top: 48rpx;
  text-align: center;
}

.np-track-title {
  display: block;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 36rpx;
  font-weight: 400;
  font-style: italic;
  color: #ffffff;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.np-track-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #777777;
}

.np-dot {
  color: #333333;
}

.np-bitrate {
  padding: 4rpx 16rpx;
  border: 1px solid #262626;
}

.np-bitrate text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--theme);
  text-transform: uppercase;
}

/* 播放控制 */
.np-controls {
  margin-top: 48rpx;
  width: 100%;
  max-width: 500rpx;
}

.np-progress {
  position: relative;
  width: 100%;
  height: 4rpx;
  background-color: #262626;
  margin-bottom: 16rpx;
}

.np-progress-fill {
  height: 100%;
  background-color: var(--theme);
  transition: width 0.3s;
}

.np-progress-dot {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background-color: var(--theme);
  border-radius: 50%;
}

.np-times {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  margin-bottom: 32rpx;
}

.np-buttons {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
}

.np-btn {
  color: #ffffff;
  font-size: 40rpx;
}

.np-btn--play {
  width: 100rpx;
  height: 100rpx;
  border: 1px solid #262626;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.np-btn--play text {
  color: var(--theme);
  font-size: 40rpx;
}

.np-options {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 48rpx;
  font-size: 32rpx;
  color: #555555;
}

.np-footer {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1px solid #262626;
}

.np-footer text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

/* ===== 迷你播放器 ===== */
.mini-player {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  z-index: 100;
  height: 100rpx;
  background: rgba(12,12,12,0.9);
  border-top: 1px solid #262626;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.mini-player-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.mini-player-img {
  width: 64rpx;
  height: 64rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
}

.mini-player-info {
  min-width: 0;
}

.mini-player-title {
  display: block;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 22rpx;
  font-weight: 400;
  color: #ffffff;
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 2rpx;
}

.mini-player-author {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #666666;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.mini-player-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.mini-player-btn {
  color: #666666;
  font-size: 28rpx;
}

.bottom-placeholder {
  height: 160rpx;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 年份选择弹窗（缩小版） ===== */
.year-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.year-picker-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.year-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background-color: #000000;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.year-picker--show {
  transform: translateY(0);
}

.year-picker-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
}

.year-picker-title {
  flex: 1;
  text-align: center;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  color: #ffffff;
}

.year-picker-close {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #888888;
  padding: 6rpx;
}

.year-picker-confirm {
  flex-shrink: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--theme);
  padding: 6rpx 12rpx;
}

.year-picker-confirm:active {
  opacity: 0.6;
}

.year-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26rpx;
  color: #aaaaaa;
  background-color: #000000;
}
