<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}" style="--theme: {{themeColor}}; --theme-r: {{themeR}}; --theme-g: {{themeG}}; --theme-b: {{themeB}};">
  <!-- 移动端筛选滚动 -->
  <scroll-view class="social-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="social-filter-row">
      <view
        wx:for="{{[
          {key: 'ALL', label: '全部'},
          {key: 'WEIBO', label: '微博'},
          {key: 'DOUYIN', label: '抖音'},
          {key: 'XIAOHONGSHU', label: '小红书'},
          {key: 'INSTAGRAM', label: 'Instagram'}
        ]}}"
        wx:key="key"
        class="social-filter-item {{selectedPlatform === item.key ? 'social-filter-item--active' : ''}}"
        data-platform="{{item.key}}"
        bind:tap="onPlatformChange"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 动态列表 -->
  <view class="social-list">
    <view wx:for="{{filteredPosts}}" wx:key="id" class="social-post">
      <!-- 头部 -->
      <view class="post-head">
        <view class="post-head-left">
          <text class="post-icon">{{item.icon === 'share' ? '↗' : item.icon === 'camera_alt' ? '📷' : '🎬'}}</text>
          <text class="post-head-title">{{item.title}}</text>
        </view>
        <text class="post-head-date">{{item.date}}</text>
      </view>

      <!-- 图片网格 -->
      <view class="post-image-grid {{item.images.length === 1 ? 'post-image-grid--single' : ''}}">
        <view
          wx:for="{{item.images}}"
          wx:key="index"
          class="post-image-item {{item.images.length === 1 ? 'post-image-item--wide' : ''}}"
        >
          <image class="post-image" src="{{item}}" mode="aspectFill" lazy-load />
        </view>
      </view>

      <!-- 尾部信息 -->
      <view class="post-foot">
        <text class="post-foot-time">{{item.publishedTime}}</text>
        <view class="post-foot-right">
          <view class="post-platform-badge">
            <text>{{item.platform}}</text>
          </view>
          <view class="post-link-btn">
            <text>↗</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{filteredPosts.length === 0}}" class="empty-state">
      <text class="empty-text">NO CORRESPONDING SOCIAL ENTRIES IN THIS FIELD</text>
    </view>
  </view>

  <view class="bottom-placeholder"></view>
</scroll-view>

<bottom-tab-bar current="social" tabs="{{tabTabs}}" />
