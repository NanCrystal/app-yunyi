.page {
  height: 100%;
  background-color: #000000;
}

/* ===== 筛选栏 ===== */
.social-filter-scroll {
  padding: 24rpx 48rpx;
  border-bottom: 1px solid #262626;
}

.social-filter-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.social-filter-item {
  padding: 12rpx 0;
  border-bottom: 2rpx solid transparent;
  flex-shrink: 0;
}

.social-filter-item text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #777777;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.social-filter-item--active {
  border-bottom-color: var(--theme);
}

.social-filter-item--active text {
  color: var(--theme);
}

/* ===== 动态列表 ===== */
.social-list {
  padding: 0 48rpx;
}

.social-post {
  padding: 48rpx 0;
  border-bottom: 1px solid #262626;
}

/* 头部 */
.post-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.post-head-left {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
}

.post-icon {
  font-size: 28rpx;
  color: var(--theme);
  padding-top: 4rpx;
}

.post-head-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 28rpx;
  font-weight: 400;
  font-style: italic;
  color: #ffffff;
  line-height: 1.7;
  flex: 1;
}

.post-head-date {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}

/* 图片网格 */
.post-image-grid {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  padding: 8rpx;
  border: 1px solid #262626;
  background-color: #0a0a0a;
  margin-bottom: 24rpx;
}

.post-image-grid--single {
  display: flex;
}

.post-image-item {
  width: calc(33.33% - 6rpx);
  aspect-ratio: 1;
  overflow: hidden;
  border: 1px solid #262626;
}

.post-image-item--wide {
  width: 100%;
  aspect-ratio: 16/9;
}

.post-image {
  width: 100%;
  height: 100%;
  filter: grayscale(1);
}

/* 尾部 */
.post-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.post-foot-time {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.post-foot-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.post-platform-badge {
  padding: 6rpx 20rpx;
  border: 1px solid rgba(142,216,131,0.3);
  background: rgba(142,216,131,0.05);
}

.post-platform-badge text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 2rpx;
}

.post-link-btn {
  width: 52rpx;
  height: 52rpx;
  border: 1px solid #262626;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-link-btn text {
  color: #555555;
  font-size: 24rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  border: 1px dashed #262626;
  margin-top: 48rpx;
}

.empty-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  text-align: center;
}

.bottom-placeholder {
  height: 160rpx;
}
