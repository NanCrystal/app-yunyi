.page {
  min-height: 100vh;
  background-color: #000000;
  overflow: hidden;
}
/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
  transform: rotateY(180deg);
}

.custom-nav-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
  text-transform: uppercase;
}
/* ===== 列表视图 ===== */
.audio-container {
  display: flex;
  flex-direction: row;
}

.month-nav {
  width: 120rpx;
  flex-shrink: 0;
  border-right: 1px solid #262626;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;
  position: sticky;
  top: 0;
  height: 100%;
  align-self: flex-start;
}

/* 年份选择器（缩小版） */
.date-picker-year {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border: 1px solid #333333;
  border-radius: 6rpx;
  margin-bottom: 32rpx;
}

.date-picker-year:active {
  opacity: 0.7;
}

.year-text {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #ffffff;
}

.year-arrow {
  font-size: 12rpx;
  color: #888888;
}

.month-nav-label {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  display: block;
  color: #555555;
  padding: 12rpx 0 12rpx 12rpx;
}

.month-nav-label--active {
  color: var(--theme);
  font-weight: 600;
}

.month-nav-item {
  padding: 10rpx 0;
  margin-bottom: 2rpx;
}

.month-nav-item text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  color: #555555;
  display: block;
  padding: 12rpx 0 12rpx 12rpx;
  text-align: left;
}

.month-nav-item--active text {
  color: var(--theme);
  font-weight: 600;
}

.audio-content {
  flex: 1;
  min-width: 0;
  height: 100%;
}

/* 隐藏 scroll-view 滚动条 */
.audio-content::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
  background: transparent;
}
.audio-list-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding: 32rpx 48rpx 16rpx;
  border-bottom: 1px solid #262626;
}

.audio-list-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.audio-list-count {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #555555;
  text-transform: uppercase;
}

.audio-month {
  padding: 0 48rpx;
}

.audio-month-title {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 24rpx 0 12rpx;
  border-bottom: 1px solid #262626;
  background-color: #000000;
}

.audio-month-title text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.audio-tracks {
  display: flex;
  flex-direction: column;
}

.audio-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 16rpx;
  border-bottom: 1px solid #262626;
}

.audio-track-img {
  width: 100rpx;
  height: 100rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
  /* filter: grayscale(1); */
  opacity: 0.75;
}

/* 无封面时的黑色占位 + 默认 icon */
.audio-track-img-fallback {
  width: 100rpx;
  height: 100rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.75;
}

.audio-track-img-fallback-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
}

.audio-track-info {
  flex: 1;
  min-width: 0;
}

.audio-track-name {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26rpx;
  font-weight: 400;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.audio-track-name--active {
  color: var(--theme);
}

.audio-track-meta {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #777777;
  text-transform: uppercase;
}

.audio-track-play {
  width: 56rpx;
  height: 56rpx;
  border: 1px solid #262626;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #000000;
}

.audio-track-play-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

/* ===== 全屏播放器 ===== */
.now-playing-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background-color: #1a1a1e;
  display: flex;
  flex-direction: column;
}

.np-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 88rpx 48rpx 60rpx;
  overflow-y: auto;
}

/* 唱针 */
.np-needle-wrap {
  position: relative;
  width: 220rpx;
  height: 250rpx;
  margin-bottom: -60rpx;
  z-index: 10;
  transform-origin: 28rpx 32rpx;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.np-needle--paused {
  transform: rotate(-30deg);
}

.np-needle--playing {
  transform: rotate(0deg);
}

.np-needle {
  width: 100%;
  height: 100%;
  filter: brightness(0) invert(1);
}

/* 专辑封面 */
.np-cover-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 56rpx;
}

/* 外层旋转容器 + 外层浅色边框 + 倾斜效果 */
.np-cover-spin {
  width: 360rpx;
  height: 360rpx;
  padding: 60rpx;
  border-radius: 50%;
  border: 3rpx solid
    rgba(var(--theme-r, 100), var(--theme-g, 180), var(--theme-b, 220), 0.2);
  transform: rotate(-12deg);
  animation: np-cover-spin 25s linear infinite;
  box-shadow: 0 0 80rpx 10rpx
    rgba(var(--theme-r, 100), var(--theme-g, 180), var(--theme-b, 220), 0.15);
}

/* 内层容器 + 内层主题色边框 */
.np-cover-spin-inner {
  width: 100%;
  height: 100%;
  /* padding: 12rpx; */
  border-radius: 50%;
  /* border-radius: 24rpx; */
  border: 3rpx solid var(--theme, #4ab8d6);

  overflow: hidden;
  position: relative;
}

@keyframes np-cover-spin {
  from {
    transform: rotate(-12deg);
  }
  to {
    transform: rotate(348deg);
  }
}

.np-cover-img {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  opacity: 0.95;
}

/* 无封面时的黑色占位 + 默认 icon */
.np-cover-fallback {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.np-cover-fallback-icon {
  width: 40%;
  height: 40%;
  opacity: 0.5;
}

/* 中间圆形装饰（唱片效果） */
.np-cover-disc {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2a2a35 0%, #1a1a22 100%);
  border: 3rpx solid var(--theme, #4ab8d6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24rpx
      rgba(var(--theme-r, 100), var(--theme-g, 180), var(--theme-b, 220), 0.4),
    inset 0 0 16rpx rgba(0, 0, 0, 0.6);
}

.np-cover-disc-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: var(--theme, #4ab8d6);
  box-shadow: 0 0 20rpx
    rgba(var(--theme-r, 100), var(--theme-g, 180), var(--theme-b, 220), 0.7);
}

/* 元信息 */
.np-meta {
  text-align: center;
  margin-bottom: 56rpx;
}

.np-track-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.np-track-subtitle {
  display: block;
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--theme, #4ab8d6);
  letter-spacing: 2rpx;
  opacity: 0.9;
}

/* 音频波形可视化 */
.np-visualizer {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  height: 120rpx;
  margin-bottom: 56rpx;
  padding: 0 20rpx;
}

.np-bar {
  width: 8rpx;
  background: linear-gradient(
    to top,
    var(--theme, #4ab8d6) 0%,
    rgba(var(--theme-r, 100), var(--theme-g, 180), var(--theme-b, 220), 0.4)
      100%
  );
  border-radius: 4rpx;
  min-height: 8rpx;
  transition: height 0.15s ease;
}

/* 播放控制 */
.np-controls {
  width: 100%;
  max-width: 600rpx;
}

/* 全屏播放进度条 */
.np-progress {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  margin-bottom: 56rpx;
}

.np-progress-bar {
  /* flex: 1; */
  height: 6rpx;
  background: #333333;
  border-radius: 3rpx;
  position: relative;
  overflow: visible;
}

.np-progress-fill {
  height: 100%;
  background: var(--theme, #4ab8d6);
  border-radius: 3rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  transition: width 0.1s linear;
}

.np-progress-thumb {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
  position: absolute;
  right: -12rpx;
  flex-shrink: 0;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.np-progress:active .np-progress-fill {
  transition: none;
}

.np-progress:active .np-progress-thumb {
  opacity: 1;
}

.np-progress-time-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8rpx;
}

.np-progress-time {
  font-family: "Courier New", Courier, monospace;
  font-size: 24rpx;
  color: var(--theme, #4ab8d6);
}

.np-progress-time-left {
  text-align: left;
}

.np-progress-time-right {
  text-align: right;
}

.np-buttons {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.np-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 36rpx;
  flex-shrink: 0;
}

.np-btn--play {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: linear-gradient(
    135deg,
    var(--theme, #4ab8d6) 0%,
    rgba(var(--theme-r, 100), var(--theme-g, 180), var(--theme-b, 220), 0.85)
      100%
  );
  box-shadow: 0 8rpx 32rpx
      rgba(var(--theme-r, 100), var(--theme-g, 180), var(--theme-b, 220), 0.4),
    0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.np-btn--play:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.np-icon-play {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0) invert(1);
}

.np-icon-skip {
  width: 42rpx;
  height: 42rpx;
  filter: brightness(0) invert(1);
}
.cloase-np-btn {
  position: absolute;
  top: 120rpx;
  left: 20rpx;
}
.np-icon-collapse {
  width: 32rpx;
  height: 32rpx;
  filter: brightness(0) invert(1) opacity(0.6);
}
.np-icon-list {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ===== 迷你播放器 ===== */
.mini-player {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(12, 12, 12, 0.9);
  border-top: 1px solid #262626;
}

.mini-player-progress {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 32rpx;
  gap: 16rpx;
}

.mini-player-progress-bar {
  flex: 1;
  height: 4rpx;
  background: #333333;
  border-radius: 2rpx;
  overflow: hidden;
}

.mini-player-progress-fill {
  height: 100%;
  background: var(--theme, #4ab8d6);
  border-radius: 2rpx;
  transition: width 0.3s linear;
}

.mini-player-progress-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  color: #666666;
  flex-shrink: 0;
  min-width: 100rpx;
  text-align: right;
}

.mini-player-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

.mini-player-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.mini-player-img {
  width: 64rpx;
  height: 64rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
}

/* 无封面时的黑色占位 + 默认 icon */
.mini-player-img-fallback {
  width: 64rpx;
  height: 64rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-player-img-fallback-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.mini-player-info {
  min-width: 0;
}

.mini-player-title {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22rpx;
  font-weight: 400;
  color: #ffffff;
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 2rpx;
}

.mini-player-author {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #666666;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.mini-player-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.mini-player-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-player-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}

.bottom-placeholder {
  height: 160rpx;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 年份选择弹窗（缩小版） ===== */
.year-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.year-picker-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.year-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background-color: #000000;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.year-picker--show {
  transform: translateY(0);
}

.year-picker-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
}

.year-picker-title {
  flex: 1;
  text-align: center;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  color: #ffffff;
}

.year-picker-close {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #888888;
  padding: 6rpx;
}

.year-picker-confirm {
  flex-shrink: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--theme);
  padding: 6rpx 12rpx;
}

.year-picker-confirm:active {
  opacity: 0.6;
}

.year-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26rpx;
  color: #aaaaaa;
  background-color: #000000;
}

.empty-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
