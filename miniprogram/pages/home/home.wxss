/* ===== 首页 ===== */

.page {
  height: 100%;
  background-color: #000000;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-home-icon {
  width: 40rpx;
  height: 40rpx;
}

.custom-nav-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
}

/* ===== Hero 轮播 ===== */
.hero {
  position: relative;
  width: 100%;
  height: 640rpx;
  overflow: hidden;
}

/* Hero 纯视频模式（无swiper） */
.hero-video-container {
  position: relative;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.hero-video-player {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

/* 视频加载中遮罩 */
.hero-video-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #000000;
  z-index: 5;
}

.hero-video-loading-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 4rpx;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    #000000 0%,
    rgba(0, 0, 0, 0.4) 40%,
    transparent 100%
  );
  z-index: 2;
  pointer-events: none;
}

.hero-content {
  position: absolute;
  left: 48rpx;
  bottom: 96rpx;
  z-index: 3;
  max-width: 560rpx;
}

.hero-role-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--theme);
}

.hero-role {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: var(--theme);
}

.hero-name {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 64rpx;
  font-weight: 400;
  letter-spacing: 12rpx;
  text-transform: uppercase;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.hero-desc {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: #cccccc;
}

.hero-dots {
  position: absolute;
  right: 48rpx;
  bottom: 96rpx;
  z-index: 3;
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.hero-dot-item {
  width: 16rpx;
  height: 6rpx;
  background-color: #555555;
  transition: all 0.3s;
}

.hero-dot-item--active {
  background-color: var(--theme);
  width: 64rpx;
}

/* Hero 空状态 */
.hero-empty-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(
    to top,
    #000000 0%,
    rgba(0, 0, 0, 0.6) 40%,
    rgba(0, 0, 0, 0.3) 100%
  );
}

.hero-empty-image {
  width: 300rpx;
  height: 180rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.hero-empty-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #999999;
}

/* ===== 状态栏 ===== */
.status-bar {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  gap: 32rpx;
  padding: 16rpx 48rpx;
  border-bottom: 1px solid #262626;
}

.status-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: #555555;
  text-transform: uppercase;
}

/* ===== 通用区块 ===== */
.section {
  padding: 32rpx 48rpx 0;
}

/* ===== 最新动态卡片 ===== */
.post-card {
  margin-top: 24rpx;
  padding: 40rpx;
}

.post-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
  border-radius: 50%;
}

.post-header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.post-author {
  font-family: "Courier New", Courier, monospace;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.post-time {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #555555;
  text-transform: uppercase;
}

.post-badge {
  /* border: 1px solid #555555; */
  /* padding: 6rpx 12rpx; */
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-badge-icon {
  width: 40rpx;
  height: 40rpx;
}

.post-content-wrap {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.post-content {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.7;
  color: #ffffff;
  display: -webkit-box;
  overflow: hidden;
  word-break: break-all;
  flex: 1;
}

.post-content--collapsed {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-expand-btn {
  flex-shrink: 0;
  padding-left: 12rpx;
  margin-top: 4rpx;
}

.post-expand-btn text {
  font-family: "Courier New", Courier, monospace;
  font-size: 24rpx;
  color: var(--theme);
}

.post-images {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.post-img {
  width: 220rpx;
  height: 220rpx;
  border: 1px solid #262626;
}

.post-video-wrap {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border: 1px solid #262626;
  overflow: hidden;
}

.post-video-cover {
  width: 100%;
  height: 100%;
  filter: grayscale(10%);
}

.post-video-cover--empty {
  background-color: #000000;
}

.post-video-play {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  transform: translate(-50%, -50%);
  opacity: 0.85;
}

/* ===== 近期行程 ===== */
.schedule-card {
  margin-top: 24rpx;
  padding: 40rpx;
  position: relative;
}

.schedule-badge {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  border: 1px solid rgba(220, 60, 60, 0.5);
  padding: 4rpx 16rpx;
}

.schedule-badge-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(255, 100, 100, 0.85);
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.schedule-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* gap: 32rpx; */
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1px solid #262626;
}
.schedule-item-inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-top: 1px solid #262626;
}
.schedule-item:first-child {
  border-top: none;
  padding-top: 0;
}
.schedule-poster-img {
  width: 100rpx;
  height: 160rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
}
.schedule-date {
  font-size: 44rpx;
  font-weight: 600;
  font-family: "Menlo", "Courier New", monospace;
  letter-spacing: 0.05em;
  color: var(--theme);
  /* letter-spacing: 2rpx; */
  /* padding-top: 4rpx; */
}

.schedule-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.schedule-title {
  font-family: "Hiragino Mincho ProN", "Songti SC", "Noto Serif SC", serif;
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  color: #ffffff;
  text-transform: uppercase;
}

.schedule-location {
  font-family: "Arial Narrow", "Helvetica Neue", sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  color: #999999;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.schedule-status {
  background: rgba(142, 216, 131, 0.1);
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}

.schedule-status-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ===== 图片档案馆 ===== */
.photo-grid {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  margin-top: 24rpx;
}

.photo-grid-item {
  flex: 0 0 calc((100% - 16rpx) / 3);
  aspect-ratio: 3/4;
  background-color: #141414;
  border: 1px solid #262626;
  overflow: hidden;
  position: relative;
}

.photo-grid-item:last-child {
  display: flex;
}

.photo-grid-img {
  width: 100%;
  height: 100%;
  /* filter: grayscale(1); */
}

.photo-grid-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
}

.photo-grid-label {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #cccccc;
}

/* ===== 视频档案馆 ===== */
.video-feature {
  margin-top: 24rpx;
  aspect-ratio: 16/9;
  position: relative;
  border: 1px solid #262626;
  background-color: #141414;
  overflow: hidden;
}

.video-feature-img {
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

/* 无封面时的占位背景 */
.video-feature-img--placeholder {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

/* 视频未就绪状态 */
.video-feature--not-ready {
  background: #141414;
}

.video-status-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 3;
}

.video-status-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #333333;
  border-top-color: #555555;
  border-radius: 50%;
  opacity: 0.4;
}

.video-status-spinner--active {
  opacity: 1;
  border-top-color: var(--theme, #8ed883);
  animation: spin 0.9s linear infinite;
}

.video-status-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  color: #666666;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.video-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border: 1px solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-play-icon {
  color: #ffffff;
  font-size: 36rpx;
  margin-left: 6rpx;
}

.video-feature-info {
  background-color: rgba(0, 0, 0, 0.1);
  position: absolute;
  padding: 12rpx;
  left: 0rpx;
  bottom: 0rpx;
  z-index: 2;
}

.video-feature-label {
  display: block;
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: var(--theme);
  margin-bottom: 4rpx;
}

.video-feature-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  /* font-weight: 400; */
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #ffffffc4;
  opacity: 0.8;

  /* 最多2行，超出显示省略号 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== 小卡档案馆 ===== */
.card-scroll {
  margin-top: 24rpx;
  width: 100%;
}

.card-scroll-inner {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  padding: 8rpx 0;
}

.photocard-item {
  flex: 0 0 calc((100% - 28rpx) / 3);
  aspect-ratio: 2/3;
  background-color: #0a0a0a;
  border: 1px solid #262626;
  padding-bottom: 12rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.photocard-image-wrap {
  width: 100%;
  flex: 1; /* 占据剩余空间的全部 */
  overflow: hidden;
  border: 1px solid #262626;
  /* 不要用 aspect-ratio: 2/3; */
}

.photocard-image {
  width: 100%;
  height: 100%;
  /* filter: grayscale(1); */
}

.photocard-date {
  display: block;
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #777777;
  text-transform: uppercase;
  margin-top: 12rpx;
}

.photocard-title {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22rpx;
  font-weight: 400;
  font-style: italic;
  color: #e4e2e1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  /* 保持现有样式，或者加上 */
  flex-shrink: 0; /* 防止标题被压缩 */
  margin-top: 8rpx;
}

.photocard-special {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background-color: rgba(139, 0, 0, 0.8);
  padding: 4rpx 12rpx;
}

.photocard-special text {
  font-family: "Courier New", Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ===== 语音馆 ===== */
.voice-card {
  position: relative;
  margin-top: 24rpx;
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.voice-corners {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.voice-corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
}

.voice-corner--tl {
  top: 0;
  left: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  border-left: 1px solid rgba(255, 255, 255, 0.2);
}
.voice-corner--tr {
  top: 0;
  right: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  border-right: 1px solid rgba(255, 255, 255, 0.2);
}
.voice-corner--bl {
  bottom: 0;
  left: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  border-left: 1px solid rgba(255, 255, 255, 0.2);
}
.voice-corner--br {
  bottom: 0;
  right: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  border-right: 1px solid rgba(255, 255, 255, 0.2);
}

.voice-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.voice-desc {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: #cccccc;
  margin-bottom: 48rpx;
}

.voice-disc {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border: 1px solid #262626;
  border-radius: 50%;
  padding: 10rpx;
  margin-bottom: 24rpx;
}

.voice-disc--spinning {
  -webkit-animation: spin 20s linear infinite;
  animation: spin 20s linear infinite;
}

@-webkit-keyframes spin {
  from {
    -webkit-transform: rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg);
  }
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.voice-disc-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.6);
  /* filter: grayscale(1) brightness(0.9); */
}

/* 无封面时的黑色占位 + 默认 icon */
.voice-disc-img-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.6);
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-disc-img-fallback-icon {
  width: 40%;
  height: 40%;
  opacity: 0.5;
}

.voice-disc-center {
  position: absolute;
  top: 50%;
  left: 50%;
  -webkit-transform: translate(-50%, -50%);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.voice-disc-center-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #000000;
  border: 2rpx solid #333333;
}

.voice-track-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: var(--theme);
  margin-top: 48rpx;
}

.voice-track-sub {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #777777;
  letter-spacing: 6rpx;
  margin-top: 12rpx;
}

.voice-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1px solid #1a1a1a;
  width: 100%;
  max-width: 400rpx;
}

.voice-time {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

.voice-play-btn {
  width: 80rpx;
  height: 80rpx;
  border: 1px solid #333333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.voice-play-btn--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.voice-play-icon {
  width: 36rpx;
  height: 36rpx;
}

.voice-progress {
  width: 100%;
  max-width: 400rpx;
  height: 4rpx;
  background-color: #1a1a1a;
  margin-top: 32rpx;
  overflow: hidden;
}

.voice-progress-fill {
  height: 100%;
  background-color: var(--theme);
  transition: width 0.3s;
}

.voice-waveform {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
  height: 80rpx;
  width: 100%;
  margin-top: 32rpx;
}

.voice-wavebar {
  width: 6rpx;
  background-color: var(--theme);
  border-radius: 2rpx;
  animation: waveGrow 1.2s ease-in-out infinite alternate;
  height: 8rpx;
}

@keyframes waveGrow {
  0% {
    height: 20rpx;
  }
  100% {
    height: 80rpx;
  }
}

/* ===== 角色切换 ===== */
.char-switch {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 32rpx;
}

.char-switch-label {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.char-switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.char-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.5;
}

.char-item--active {
  opacity: 1;
}

.char-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border: 2rpx solid #262626;
  overflow: hidden;
  padding: 4rpx;
}

.char-avatar {
  width: 100%;
  height: 100%;
}

.char-name {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ===== 角色切换弹窗 ===== */
.switch-dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background-color: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-dialog {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 80rpx;
  border-radius: 32rpx;
  background-color: #141414;
  border: 1px solid #262626;
  width: 520rpx;
}

.switch-dialog-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid #333333;
  margin-bottom: 32rpx;
}

.switch-dialog-text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.switch-dialog-name {
  font-family: "Courier New", Courier, monospace;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.switch-dialog-hint {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22rpx;
  font-style: italic;
  color: #666666;
  margin-bottom: 40rpx;
}

.switch-dialog-progress-wrap {
  width: 100%;
  height: 6rpx;
  background-color: #262626;
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.switch-dialog-progress-bar {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.1s linear;
}

.switch-dialog-percent {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

/* ===== 底部占位 ===== */
.bottom-placeholder {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

/* ===== 骨架屏通用样式 ===== */
.skeleton-shimmer {
  position: relative;
  background-color: #1a1a1a;
  overflow: hidden;
}

.skeleton-shimmer::after {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.05) 50%,
    transparent 100%
  );
  animation: shimmer 2s infinite;
}

@-webkit-keyframes shimmer {
  from {
    left: -100%;
  }
  to {
    left: 100%;
  }
}

@keyframes shimmer {
  from {
    left: -100%;
  }
  to {
    left: 100%;
  }
}

.skeleton-line {
  display: block;
  border-radius: 4rpx;
}

/* ===== Hero 骨架屏 ===== */
.skeleton-hero {
  width: 100%;
  height: 640rpx;
}

.skeleton-hero-img {
  width: 100%;
  height: 100%;
}

/* ===== 最新动态骨架屏 ===== */
.skeleton-post {
  padding: 40rpx;
}

.skeleton-post-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.skeleton-post-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-images {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.skeleton-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 4rpx;
}

/* ===== 近期行程骨架屏 ===== */
.skeleton-schedule {
  padding: 40rpx 20rpx;
}

.skeleton-schedule-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1px solid #262626;
}

.skeleton-schedule-item:first-child {
  border-top: none;
  padding-top: 0;
}

.skeleton-schedule-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

/* ===== 图片档案馆骨架屏 ===== */
.skeleton-photo-item {
  aspect-ratio: 3/4;
  background-color: #141414 !important;
  border: 1px solid #262626;
}

.skeleton-photo-img {
  width: 100%;
  height: 100%;
}

/* ===== 视频档案馆骨架屏 ===== */
.skeleton-video {
  aspect-ratio: 16/9;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
  background-color: #141414 !important;
  border: 1px solid #262626;
}

.skeleton-video-img {
  width: 100%;
  height: 300rpx;
  border-radius: 4rpx;
}

.skeleton-video-info {
  width: 100%;
  margin-top: 24rpx;
  padding-left: 16rpx;
}

/* ===== 小卡档案馆骨架屏 ===== */
.skeleton-photocard {
  aspect-ratio: 3/4;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skeleton-photocard-img {
  aspect-ratio: 2/3;
  width: 100%;
  border-radius: 4rpx;
}

/* ===== 语音馆骨架屏 ===== */
.skeleton-voice {
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skeleton-voice-title,
.skeleton-voice-desc {
  border-radius: 4rpx;
}

.skeleton-voice-disc {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  margin-top: 32rpx;
}

/* ===== 错误状态样式 ===== */
.error-card {
  margin-top: 24rpx;
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
}

.error-card--small {
  min-height: 160rpx;
  padding: 32rpx 48rpx;
}

.error-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 24rpx;
  color: #666666;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.error-retry-btn {
  padding: 16rpx 32rpx;
  border: 1px solid var(--theme);
  border-radius: 4rpx;
}

.error-retry-btn text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  color: var(--theme);
  letter-spacing: 2rpx;
}
