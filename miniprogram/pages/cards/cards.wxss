/* pages/cards/cards.wxss */

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
  transform: rotateY(180deg);
}

.custom-nav-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
  text-transform: uppercase;
}

/* ─── 固定标签栏（导航栏下方） ─── */
.tag-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  background-color: #000000;
  padding: 16rpx 24rpx 12rpx;
}

/* 横向滚动容器 */
.tag-scroll {
  white-space: nowrap;
}

.sub-tags-wrap {
  margin-top: 12rpx;
  white-space: nowrap;
}

.tag-list {
  display: inline-flex;
  gap: 12rpx;
}

.sub-list {
  gap: 12rpx;
}

/* Tag 基础样式 — 暗色系，与 filter-tags 一致 */
.tag-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: transparent;
  border: 1px solid #262626;
  border-radius: 40rpx;
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  color: #cccccc;
  flex-shrink: 0;
}

/* 选中态 — 主题色 */
.tag-active {
  background-color: var(--theme);
  border-color: var(--theme);
  color: #ffffff;
}

/* ─── 小卡列表（一行三张） ─── */
.card-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.card {
  width: 31.6%;
  height: 0;
  padding-bottom: 48.8%; /* 55/85 ≈ 0.647, 31.6% * (85/55) ≈ 48.8% */
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 2.6%;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

/* 每行第三个不要右边距 */
.card:nth-child(3n) {
  margin-right: 0;
}

.card-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.card-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 10rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.75));
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-name {
  font-size: 22rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-date {
  font-size: 18rpx;
  color: rgba(255,255,255,0.7);
}

.empty-tip {
  width: 100%;
  text-align: center;
  color: #666;
  font-size: 26rpx;
  margin-top: 80rpx;
}

/* ─── 主滚动区域 ─── */
.main-scroll {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.main-content {
  padding: 0 24rpx 24rpx;
}

/* ─── 加载更多 ─── */
.load-more {
  width: 100%;
  padding: 24rpx 0 40rpx;
  display: flex;
  justify-content: center;
}

.load-more-text {
  font-size: 22rpx;
  color: #999;
}
