.page {
  height: 100%;
  background-color: #000000;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}

.custom-nav-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
}

/* ===== 月份选择器 ===== */
.date-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 48rpx;
  background-color: #000000;
  border-bottom: 1px solid #262626;
}

/* 年份 */
.date-picker-year {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border: 1px solid #333333;
  border-radius: 8rpx;
}

.date-picker-year:active {
  opacity: 0.7;
}

.year-text {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #ffffff;
}

.year-arrow {
  font-size: 16rpx;
  color: #888888;
  margin-left: 4rpx;
}

/* 月份滚动区 */
.date-picker-months {
  flex: 1;
  white-space: nowrap;
  padding-right:  0;
}

.months-row {
  white-space: nowrap;
  padding-right:  0;
  width: fit-content;
}

.month-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  padding: 10rpx 24rpx;
  border: 1px solid #333333;
  border-radius: 8rpx;
  background-color: #141414;
}

.month-tag:last-child {
  margin-right: 0;
}

.month-tag text {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  color: #aaaaaa;
}

.month-tag--active {
  background-color: var(--theme);
  border-color: var(--theme);
}

.month-tag--active text {
  color: #ffffff;
  font-weight: 700;
}

/* 年份弹窗 */
.year-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.year-picker-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.year-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background-color: #000000;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.year-picker--show {
  transform: translateY(0);
}

.year-picker-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 48rpx 16rpx;
}

.year-picker-title {
  flex: 1;
  text-align: center;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 30rpx;
  font-weight: 400;
  color: #ffffff;
}

.year-picker-close {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #888888;
  padding: 8rpx;
}

.year-picker-confirm {
  flex-shrink: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--theme);
  padding: 8rpx 16rpx;
}

.year-picker-confirm:active {
  opacity: 0.6;
}

.year-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 30rpx;
  color: #aaaaaa;
  background-color: #000000;
}

/* 覆盖 picker-view 内部默认样式 */
.year-picker picker-view {
  background-color: #000000;
}

.year-picker picker-view-column {
  background-color: #000000;
}

.year-picker picker-view-column > view {
  background-color: #000000;
}

/* 强制移除 picker-view 遮罩层 */
.wx-picker-view-mask {
  background: transparent !important;
  background-image: none !important;
}

.wx-picker-view-mask::before,
.wx-picker-view-mask::after {
  background: transparent !important;
  background-image: none !important;
}



.filter-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx ;
  background-color: #000000;
  border-bottom: 1px solid #262626;
}

.filter-bar filter-tags {
  flex: 1;
}

/* 筛选图标按钮 */
.filter-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.filter-icon:active {
  opacity: 0.4;
}

/* ===== 时间线 ===== */
.timeline {
  position: relative;
  padding: 48rpx 48rpx 0;
}

.timeline-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 60rpx;
  width: 1px;
  background-color: #262626;
}

.timeline-group {
  position: relative;
  margin-bottom: 64rpx;
}

.timeline-date {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding-left: 48rpx;
}

.timeline-dot {
  position: absolute;
  left: 54rpx;
  width: 18rpx;
  height: 18rpx;
  border: 1px solid var(--theme);
  border-radius: 50%;
  background-color: #000000;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.timeline-dot-inner {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: var(--theme);
}

.timeline-date-text {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 4rpx;
}

.timeline-events {
  padding-left: 96rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 事件卡片 ===== */
.event-card {
  background-color: #141414;
  border: 1px solid #262626;
  padding: 36rpx;
}

.event-card--cancelled {
  opacity: 0.6;
}

.event-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.event-title {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  color: #ffffff;
  flex: 1;
}

.event-title--cancelled {
  text-decoration: line-through;
  color: #666666;
}

.event-status {
  padding: 6rpx 20rpx;
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  flex-shrink: 0;
}

.status--ongoing {
  background: rgba(142, 216, 131, 0.1);
  border: 1px solid rgba(142, 216, 131, 0.2);
  color: var(--theme);
}

.status--completed {
  background: rgba(0, 100, 0, 0.1);
  border: 1px solid rgba(0, 200, 0, 0.2);
  color: #4ade80;
}

.status--cancelled {
  background: rgba(139, 0, 0, 0.1);
  border: 1px solid rgba(200, 0, 0, 0.2);
  color: #f87171;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.event-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.event-icon {
  font-size: 24rpx;
  color: #555555;
}

.event-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #cccccc;
}

.event-text-dim {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

/* 附件图片 */
.event-attachment {
  margin-top: 24rpx;
  border: 1px solid #262626;
  height: 200rpx;
  overflow: hidden;
  position: relative;
}

.event-attachment-img {
  width: 100%;
  height: 100%;
  /* filter: grayscale(1); */
  /* opacity: 0.6; */
}

.event-attachment-badge {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  padding: 4rpx 12rpx;
  border: 1px solid #333333;
}

.event-attachment-badge text {
  font-family: "Courier New", Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 2rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  border: 1px dashed #262626;
  margin: 0 48rpx;
}

.empty-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.bottom-placeholder {
  height: 160rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-container {
  padding: 48rpx 48rpx 0;
}

.skeleton-line {
  background: linear-gradient(90deg, #1a1a1a 25%, #262626 50%, #1a1a1a 75%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}

.skeleton-line--short {
  width: 200rpx;
  height: 28rpx;
  margin-bottom: 32rpx;
}

.skeleton-line--date {
  width: 180rpx;
  height: 28rpx;
}

.skeleton-line--title {
  width: 80%;
  height: 32rpx;
  margin-bottom: 20rpx;
}

.skeleton-line--text {
  width: 60%;
  height: 24rpx;
  margin-bottom: 12rpx;
}

.skeleton-timeline {
  position: relative;
  padding-left: 48rpx;
}

.skeleton-timeline-item {
  margin-bottom: 48rpx;
}

.skeleton-date-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.skeleton-dot {
  width: 18rpx;
  height: 18rpx;
  border: 1px solid #333;
  border-radius: 50%;
  background: #1a1a1a;
  flex-shrink: 0;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  background: linear-gradient(90deg, #1a1a1a 25%, #262626 50%, #1a1a1a 75%);
  background-size: 400% 100%;
}

.skeleton-card {
  background-color: #141414;
  border: 1px solid #262626;
  padding: 36rpx;
  margin-left: 48rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
