<!-- 复选框状态判断工具（WXS） -->
<wxs src="./checkbox.wxs" module="check" />
<!-- 自定义导航栏 -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="custom-nav-inner">
    <view class="custom-nav-left" bind:tap="onGoBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="custom-nav-title">图片馆</text>
    <view class="custom-nav-right" />
  </view>
</view>
<scroll-view
  id="photoScrollView"
  class="page"
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  scroll-top="{{_scrollTop}}"
  bindscroll="onScroll"
  style="--theme: {{themeColor}}; --theme-r: {{themeR}}; --theme-g: {{themeG}}; --theme-b: {{themeB}}; padding-top: {{statusBarHeight + 44}}px;"
>
  <!-- 统计信息 -->
  <view class="count-bar">
    <text class="count-num">
    </text>
    <view class="count-actions">
      <image
        class="filter-icon"
        src="../assets/icons/check.svg"
        bind:tap="onToggleCheckboxMode" />
      <image
        class="filter-icon"
        src="../assets/icons/filter.svg"
        bind:tap="onTogglfilterPicker" />
    </view>
  </view>
  <!-- 照片网格（按月分组） -->
  <view class="photos-content">
    <view
      wx:for="{{groupedPhotos}}"
      wx:key="yearMonth"
      wx:for-index="monthIdx"
      class="month-group"
    >
      <view class="month-header">
        <view class="month-header-left">
          <view
            wx:if="{{showCheckboxMode}}"
            class="checkbox-wrap"
            catchtap="onMonthCheckTap"
            data-month-idx="{{monthIdx}}"
          >
            <view class="checkbox-box {{check.isMonthAllChecked(checkedPhotoIds, item.days) ? 'checkbox-box--active' : ''}}">
              <text wx:if="{{check.isMonthAllChecked(checkedPhotoIds, item.days)}}" class="check-mark">✓</text>
            </view>
          </view>
          <text class="month-title">{{item.month}}</text>
        </view>
        <text class="month-count">{{item.count}} STILLS</text>
      </view>
      <!-- 已加载：展示真实照片 -->
      <block wx:if="{{item.loaded}}">
        <view
          wx:for="{{item.days}}"
          wx:key="day"
          wx:for-index="dayIdx"
          class="day-group"
        >
          <view class="day-header">
            <view
              wx:if="{{showCheckboxMode}}"
              class="day-checkbox-wrap"
              catchtap="onDayCheckTap"
              data-month-idx="{{monthIdx}}"
              data-day-idx="{{dayIdx}}"
            >
              <view class="checkbox-box {{check.isDayAllChecked(checkedPhotoIds, item.items) ? 'checkbox-box--active' : ''}}">
                <text wx:if="{{check.isDayAllChecked(checkedPhotoIds, item.items)}}" class="check-mark">✓</text>
              </view>
            </view>
            <text class="day-title">{{item.day}}</text>
          </view>
          <view class="photo-grid">
            <block
              wx:for="{{item.items}}"
              wx:key="id"
              wx:for-item="photo"
              wx:for-index="photoIdx"
            >
              <view
                class="photo-item"
                bindtap="{{showCheckboxMode ? 'onPhotoTap' : 'onPhotoTap'}}"
                data-id="{{photo.id}}"
              >
                <view
                  wx:if="{{showCheckboxMode}}"
                  class="photo-check"
                  catchtap="onCheckTap"
                  data-id="{{photo.id}}"
                >
                  <view class="photo-check-box {{check.isPhotoChecked(checkedPhotoIds, photo.id) ? 'photo-check-box--active' : ''}}">
                    <text wx:if="{{check.isPhotoChecked(checkedPhotoIds, photo.id)}}" class="photo-check-mark">✓</text>
                  </view>
                </view>
                <!-- 骨架屏（单张图片级别） -->
                <photo-skeleton wx:if="{{!photo.loaded}}" />
                <!-- 真实图片 -->
                <image
                  class="photo-img {{photo.loaded ? 'photo-img--visible' : ''}}"
                  src="{{photo.thumbUrl || photo.url}}"
                  mode="aspectFill"
                  lazy-load
                  webp
                  bindload="onImageLoad"
                  binderror="onImageError"
                  data-month-idx="{{monthIdx}}"
                  data-day-idx="{{dayIdx}}"
                  data-photo-idx="{{photoIdx}}" />
              </view>
            </block>
          </view>
        </view>
      </block>
      <!-- 加载中：显示 loading 骨架动画 -->
      <block wx:elif="{{item.loading}}">
        <view class="month-loading">
          <view class="month-loading-spinner">
          </view>
          <text class="month-loading-text">LOADING...</text>
        </view>
      </block>
      <!-- 未加载：骨架屏占位网格 -->
      <block wx:else>
        <view class="skeleton-grid">
          <view
            wx:for="{{item.count > 24 ? 24 : item.count}}"
            wx:key="*this"
            class="skeleton-item"
            style="animation-delay: {{(index % 12) * 0.05}}s;"
          >
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{filteredPhotos.length === 0 && !isLoading}}" class="empty-state">
      <text class="empty-text">NO CORRESPONDING PHOTOS FOUND IN ARCHIVE</text>
    </view>
    <!-- 加载中状态 -->
    <view wx:if="{{isLoading}}" class="loading-state">
      <text class="loading-text">LOADING...</text>
    </view>
  </view>
  <view class="bottom-placeholder">
    <view wx:if="{{allLoaded && groupedPhotos.length > 0}}" class="end-tip">
      <text class="end-tip-text">— END OF ARCHIVE —</text>
    </view>
  </view>
  <!-- 滚动条按钮（模拟真实滚动条，GPU加速） -->
  <view
    class="drag-btn {{isDragExpanded ? 'drag-btn--expanded' : ''}} {{showDragBtn ? 'drag-btn--visible' : ''}}"
    style="transform: {{_scrollbarTransform || 'translateY(0)'}};"
    catchtouchstart="onDragTouchStart"
    catchtouchmove="onDragTouchMove"
    catchtouchend="onDragTouchEnd"
  >
    <block wx:if="{{!isDragExpanded}}">
      <image
        class="drag-btn-icon"
        src="../assets/icons/drag.svg"
        mode="aspectFit" />
    </block>
    <block wx:else>
      <text class="drag-btn-date">{{currentDragDate}}</text>
      <image
        class="drag-btn-icon"
        src="../assets/icons/drag.svg"
        mode="aspectFit" />
    </block>
  </view>
</scroll-view>
<!-- 底部浮动统计栏（选择模式） -->
<view wx:if="{{showCheckboxMode}}" class="selection-bar {{checkedPhotoIds.length > 0 ? 'selection-bar--visible' : ''}}">
  <text class="selection-count">已选中 {{checkedPhotoIds.length}} 项</text>
  <view class="selection-actions">
    <view class="btn-download" bindtap="onDownloadSelected">
      <text>下载</text>
    </view>
    <view class="btn-cancel" bind:tap="onToggleCheckboxMode">
      <text>取消</text>
    </view>
  </view>
</view>
<!-- 筛选面板 - 顶部弹出 -->
<view
  class="filter-overlay {{showFilter ? 'filter-overlay--show' : ''}}"
  bind:tap="onCloseFilter"
  catchtouchmove="preventMove"
  style="--theme: {{themeColor}}; --theme-r: {{themeR}}; --theme-g: {{themeG}}; --theme-b: {{themeB}};"
>
  <view class="filter-dropdown {{showFilter ? 'filter-dropdown--show' : ''}}" catch:tap="preventBubble" style="padding-top: {{statusBarHeight}}px;">
    <view class="filter-panel">
      <view class="filter-row">
        <text class="filter-label">类型</text>
        <view class="filter-tags-inline">
          <view
            class="filter-tag {{selectedType.length === 0 ? 'filter-tag--active' : ''}}"
            data-type="type"
            bind:tap="onResetFilter"
          >
            <text>不限</text>
          </view>
          <view
            wx:for="{{typeItems}}"
            wx:key="id"
            class="filter-tag {{check.isInArray(selectedType, item.id) ? 'filter-tag--active' : ''}}"
            data-value="{{item.id}}"
            bind:tap="onTypeChange"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
      <view class="filter-row">
        <text class="filter-label">地点</text>
        <view class="filter-tags-inline">
          <view
            class="filter-tag {{selectedRegion.length === 0 ? 'filter-tag--active' : ''}}"
            data-type="region"
            bind:tap="onResetFilter"
          >
            <text>不限</text>
          </view>
          <view
            wx:for="{{regionItems}}"
            wx:key="id"
            class="filter-tag {{check.isInArray(selectedRegion, item.id) ? 'filter-tag--active' : ''}}"
            data-value="{{item.id}}"
            bind:tap="onRegionChange"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
      <view class="filter-row">
        <text class="filter-label">平台</text>
        <view class="filter-tags-inline">
          <view
            class="filter-tag {{selectedSystem.length === 0 ? 'filter-tag--active' : ''}}"
            data-type="system"
            bind:tap="onResetFilter"
          >
            <text>不限</text>
          </view>
          <view
            wx:for="{{platformItems}}"
            wx:key="id"
            class="filter-tag {{check.isInArray(selectedSystem, item.id) ? 'filter-tag--active' : ''}}"
            data-value="{{item.id}}"
            bind:tap="onSystemChange"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
    <!-- 底部操作按钮 -->
    <view class="filter-actions">
      <view class="filter-btn filter-btn--reset" bind:tap="onResetFilterAll">
        <text>重置</text>
      </view>
      <view class="filter-btn filter-btn--confirm" bind:tap="onConfirmFilter">
        <text>筛选</text>
      </view>
    </view>
    </view>
  </view>
</view>
<!-- 全屏预览 -->
<view
  wx:if="{{previewPhoto}}"
  class="preview-mask"
  catchtouchmove="noop"
>
  <view class="preview-body">
    <!-- 左上角关闭按钮 -->
    <view class="preview-close" style="top: {{statusBarHeight + 44 + 24}}px;" bind:tap="onClosePreview">
      <text>✕</text>
    </view>
    <view class="preview-nav preview-nav--left" bind:tap="onPrevPreview">
      <text>‹</text>
    </view>
    <image
      class="preview-img"
      src="{{previewPhoto.rawUrl || previewPhoto.url}}"
      mode="widthFix"
    />
    <view class="preview-nav preview-nav--right" bind:tap="onNextPreview">
      <text>›</text>
    </view>
    <!-- 底部叠加层：查看原图 + 计数器 -->
    <view class="preview-overlay-bottom">
      <view class="preview-view-original" bind:tap="onViewOriginal">
        <text>查看原图</text>
      </view>
      <view class="preview-counter">
        <text>{{previewIndex + 1}} / {{filteredPhotos.length}}</text>
      </view>
    </view>
  </view>
</view>
