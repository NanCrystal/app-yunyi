.page {
  height: 100%;
  background-color: #000000;
}

/* ===== 筛选面板 ===== */
.filter-panel {
  background-color: #141414;
  border: 1px solid #262626;
  margin: 24rpx 48rpx;
  padding: 32rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  width: 120rpx;
  flex-shrink: 0;
}

.filter-tags-inline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.filter-tag {
  padding: 8rpx 24rpx;
  border: 1px solid #262626;
  background: transparent;
}

.filter-tag text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #999999;
  letter-spacing: 2rpx;
}

.filter-tag--active {
  background-color: var(--theme);
  border-color: var(--theme);
}

.filter-tag--active text {
  color: #000000;
}

/* ===== 统计栏 ===== */
.count-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 48rpx;
  border-bottom: 1px solid #262626;
}

.count-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 2rpx;
}

.count-num {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ===== 照片内容 ===== */
.photos-content {
  padding: 32rpx 48rpx;
}

.month-group {
  margin-bottom: 48rpx;
}

.month-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 12rpx;
  border-bottom: 1px solid #262626;
  margin-bottom: 24rpx;
}

.month-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.month-count {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #666666;
  letter-spacing: 2rpx;
}

.day-group {
  margin-bottom: 24rpx;
}

.day-title {
  display: block;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: var(--theme);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.photo-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.photo-item {
  width: calc(33.33% - 6rpx);
  aspect-ratio: 1;
  background-color: #141414;
  border: 1px solid #262626;
  overflow: hidden;
  position: relative;
}

.photo-item:nth-child(odd):last-child,
.photo-item:only-child {
  width: 100%;
  aspect-ratio: 16/9;
}

.photo-img {
  width: 100%;
  height: 100%;
  filter: grayscale(1);
}

.photo-check {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  z-index: 1;
  padding: 8rpx;
}

.photo-check-box {
  width: 32rpx;
  height: 32rpx;
  border: 1px solid #666666;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-check-box--active {
  border-color: var(--theme);
  background-color: var(--theme);
}

.photo-check-mark {
  color: #ffffff;
  font-size: 24rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  border: 1px dashed #262626;
}

.empty-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  text-align: center;
}

/* ===== 全屏预览 ===== */
.preview-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background-color: #000000;
  display: flex;
  flex-direction: column;
}

.preview-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 40rpx;
  background: rgba(0,0,0,0.8);
  z-index: 2;
}

.preview-close {
  width: 60rpx;
  height: 60rpx;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
}

.preview-label {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #cccccc;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.preview-type-badge {
  padding: 4rpx 16rpx;
  border: 1px solid rgba(142,216,131,0.3);
}

.preview-type-badge text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--theme);
}

.preview-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.preview-img {
  max-width: 85vw;
  max-height: 60vh;
  border: 2rpx solid var(--theme);
}

.preview-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.preview-nav text {
  color: #ffffff;
  font-size: 48rpx;
}

.preview-nav--left { left: 32rpx; }
.preview-nav--right { right: 32rpx; }

.preview-counter {
  position: absolute;
  bottom: 32rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

.preview-counter text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 24rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 4rpx;
}

.preview-info {
  padding: 48rpx;
  background: linear-gradient(to top, #000000, rgba(0,0,0,0.95));
  border-top: 1px solid #1a1a1a;
}

.preview-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.preview-filename {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

.preview-date {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

.preview-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
  margin: 16rpx 0 12rpx;
}

.preview-desc {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: #cccccc;
  display: block;
  margin-bottom: 16rpx;
}

.preview-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.preview-tag {
  padding: 6rpx 20rpx;
  background-color: #1a1a1a;
  border: 1px solid #262626;
}

.preview-tag text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.preview-tag--green {
  background-color: #000000;
  border-color: rgba(142,216,131,0.2);
}

.preview-tag--green text {
  color: var(--theme);
}

.bottom-placeholder {
  height: 160rpx;
}
