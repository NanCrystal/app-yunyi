/* ===== 页面容器 ===== */
.page {
  width: 100%;
  height: 100vh;
  background-color: #000000;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部品牌区 ===== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 32rpx;
  flex-shrink: 0;
  gap: 8rpx;
}

.header-line {
  width: 60%;
  height: 1px;
  background: linear-gradient(
    to right,
    transparent,
    rgba(255, 255, 255, 0.15),
    transparent
  );
}

.header-brand {
  font-family: 'Courier New', Courier, monospace;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 20rpx;
  color: #ffffff;
  text-transform: uppercase;
  margin: 16rpx 0;
}

.header-sub {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #555555;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

/* ===== 角色卡片列表 ===== */
.card-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx 32rpx;
  gap: 20rpx;
}

/* ===== 角色卡片 ===== */
.char-card {
  position: relative;
  width: 100%;
  flex: 1;
  border: 1px solid #1a1a1a;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #050505;
}

.char-card:active {
  opacity: 0.95;
  transform: scale(0.995);
}

/* ===== 卡片背景 ===== */
.char-card-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.char-card-img {
  width: 100%;
  height: 100%;
  /* filter: grayscale(0.8) brightness(0.7); */
}

.char-card-gradient {
  position: absolute;
  inset: 0;
}



/* ===== 卡片文字覆盖层 ===== */
.char-card-content {
  position: absolute;
  /* top: 48rpx; */
  left: 48rpx;
  /* right: 48rpx; */
  bottom: 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 2;
}

.char-en-name {
  font-family: 'Courier New', Courier, monospace;
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  line-height: 1;
  margin-bottom: 8rpx;
}

.char-cn-name {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 40rpx;
  font-weight: 300;
  letter-spacing: 16rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.char-role-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.char-role-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.char-role-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

/* ===== 进入箭头 ===== */
.char-arrow {
  width: 56rpx;
  height: 56rpx;
  border: 1.5px solid;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.char-card:active .char-arrow {
  opacity: 1;
}

.char-arrow-icon {
  font-size: 28rpx;
  font-weight: 300;
}

/* ===== 读书笔记列表 ===== */
.note-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx 32rpx;
}

.note-list-title {
  font-size: 32rpx;
  color: #ffffff;
  padding: 24rpx 0 16rpx;
  letter-spacing: 8rpx;
}

.article-card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.article-card {
  background-color: #111111;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid #1a1a1a;
}

.article-card:active {
  opacity: 0.9;
  transform: scale(0.995);
}

.article-card-cover {
  width: 100%;
  height: 360rpx;
  display: block;
}

.article-card-content {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.article-card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.article-card-excerpt {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-card-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}



