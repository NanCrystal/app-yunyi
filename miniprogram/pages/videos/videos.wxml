<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}" style="--theme: {{themeColor}}; --theme-r: {{themeR}}; --theme-g: {{themeG}}; --theme-b: {{themeB}};">
  <!-- 视频详情播放器视图 -->
  <block wx:if="{{selectedVideo}}">
    <view class="player-header">
      <text class="player-breadcrumb">VIDEO OUTLINE / DETAILED PLAYING</text>
      <view class="player-close-btn" bind:tap="onCloseVideo">
        <text>CLOSE ✕</text>
      </view>
    </view>

    <!-- 播放器区域 -->
    <view class="player-wrapper">
      <image class="player-bg" src="{{selectedVideo.thumbnail}}" mode="aspectFill" />
      <view class="player-overlay">
        <view class="player-top-bar">
          <view class="player-rec-badge">
            <text>● 正在录制 / RECORDING</text>
          </view>
          <text class="player-tech-info">MASTER FRAME RECTIFICATION ON</text>
        </view>

        <view class="player-bottom-controls">
          <!-- 进度条 -->
          <view class="player-progress">
            <view class="player-progress-fill" style="width: 45%;"></view>
          </view>

          <!-- 控制按钮 -->
          <view class="player-ctrl-row">
            <view class="player-ctrl-left">
              <view class="player-ctrl-btn" bind:tap="onTogglePlay">
                <text>{{isPlaying ? '⏸' : '▶'}}</text>
              </view>
              <view class="player-ctrl-btn">
                <text>⏭</text>
              </view>
              <text class="player-time-text">{{isPlaying ? '01:42' : '00:00'}} / {{selectedVideo.duration}}</text>
            </view>
            <view class="player-ctrl-right">
              <view class="player-quality-tag">
                <text>4K HDR</text>
              </view>
              <text class="player-ctrl-icon">⚙</text>
              <text class="player-ctrl-icon">⛶</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 视频描述 -->
    <view class="player-desc">
      <text class="player-title">{{selectedVideo.title}}</text>
      <view class="player-meta">
        <text>郝熠然</text>
        <text class="player-meta-sep">|</text>
        <text>2026.06.24</text>
        <text class="player-meta-sep">|</text>
        <text>{{selectedVideo.duration}} SEC</text>
        <text class="player-meta-sep">|</text>
        <text class="player-meta-green">4K DOLBY VISION</text>
      </view>
      <view class="player-description-wrap">
        <text class="player-description-text">
          {{isDescriptionExpanded ? selectedVideo.description : selectedVideo.description.substring(0, 60) + '...'}}
        </text>
        <text class="player-expand-btn" bind:tap="onToggleDescription">{{isDescriptionExpanded ? '...收起' : '...展开'}}</text>
      </view>
      <view class="player-tags">
        <view wx:for="{{selectedVideo.tags}}" wx:key="*this" class="player-tag">
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 关联动态 -->
    <view class="player-related">
      <text class="player-related-title">关联动态 / ASSOCIATED ENTRIES</text>
      <view class="player-related-grid">
        <view class="related-card">
          <image class="related-img" src="../assets/images/1 (45).jpg" mode="aspectFill" />
          <view class="related-info">
            <text class="related-text">"午夜拍摄幕后。使用全新的35mm变形镜头…"</text>
            <text class="related-platform">INSTAGRAM • 2小时前</text>
          </view>
        </view>
        <view class="related-card">
          <image class="related-img" src="../assets/images/1 (46).jpg" mode="aspectFill" />
          <view class="related-info">
            <text class="related-text">"城市永不眠，镜头亦然。新宿凌晨3点…"</text>
            <text class="related-platform">WEIBO • 1天前</text>
          </view>
        </view>
        <view class="related-card">
          <image class="related-img" src="../assets/images/1 (47).jpg" mode="aspectFill" />
          <view class="related-info">
            <text class="related-text">"低光环境下捕捉宽动态范围的暗部校准…"</text>
            <text class="related-platform">MEDIUM • 3天前</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 视频列表视图 -->
  <block wx:else>
    <view class="list-header">
      <text class="list-title">视频馆 / MOVIE ARCHIVES</text>
      <text class="list-count">{{totalCount}} ENTRIES</text>
    </view>

    <view class="video-list">
      <view wx:for="{{monthGroups}}" wx:key="month" class="video-month">
        <view class="video-month-header">
          <view class="video-month-line"></view>
          <text class="video-month-title">{{item.month}}</text>
        </view>

        <view class="video-grid">
          <view
            wx:for="{{item.items}}"
            wx:key="id"
            class="video-card"
            data-id="{{item.id}}"
            bind:tap="onOpenVideo"
          >
            <view class="video-card-thumb">
              <image class="video-card-img" src="{{item.thumbnail}}" mode="aspectFill" lazy-load />
              <view class="video-card-play">
                <text>▶</text>
              </view>
              <view class="video-card-duration">
                <text>{{item.duration}}</text>
              </view>
              <view class="video-card-date-badge">
                <text>{{item.date}}</text>
              </view>
            </view>
            <view class="video-card-info">
              <text class="video-card-title">{{item.title}}</text>
              <text class="video-card-desc">{{item.description}}</text>
              <view class="video-card-tags">
                <view wx:for="{{item.tags}}" wx:key="*this" class="video-card-tag">
                  <text>{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="bottom-placeholder"></view>
</scroll-view>

<bottom-tab-bar current="videos" tabs="{{tabTabs}}" />
