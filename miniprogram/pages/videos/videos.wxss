.page {
  height: 100%;
  background-color: #000000;
}

/* ===== 播放器头部 ===== */
.player-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 48rpx;
  border-bottom: 1px solid #262626;
}

.player-breadcrumb {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #cccccc;
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.player-close-btn {
  padding: 8rpx 20rpx;
  border: 1px solid #262626;
}

.player-close-btn text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* ===== 播放器 ===== */
.player-wrapper {
  aspect-ratio: 16/9;
  width: 100%;
  position: relative;
  border-bottom: 1px solid #262626;
  overflow: hidden;
}

.player-bg {
  width: 100%;
  height: 100%;
  filter: brightness(0.85) saturate(0.75);
  opacity: 0.9;
}

.player-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 32rpx;
}

.player-top-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}

.player-rec-badge {
  background: rgba(0,0,0,0.6);
  border: 1px solid #262626;
  padding: 4rpx 16rpx;
}

.player-rec-badge text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.player-tech-info {
  font-family: 'Courier New', Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.5);
  letter-spacing: 2rpx;
}

.player-bottom-controls {
  width: 100%;
}

.player-progress {
  width: 100%;
  height: 4rpx;
  background: rgba(255,255,255,0.2);
  margin-bottom: 24rpx;
}

.player-progress-fill {
  height: 100%;
  background-color: var(--theme);
}

.player-ctrl-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.player-ctrl-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.player-ctrl-btn {
  color: #ffffff;
  font-size: 36rpx;
}

.player-time-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #cccccc;
}

.player-ctrl-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.player-quality-tag {
  padding: 4rpx 12rpx;
  border: 1px solid rgba(255,255,255,0.3);
}

.player-quality-tag text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: #ffffff;
}

.player-ctrl-icon {
  color: #999999;
  font-size: 28rpx;
}

/* ===== 视频描述 ===== */
.player-desc {
  padding: 40rpx 48rpx;
  border-bottom: 1px solid #262626;
}

.player-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.player-meta {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #999999;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.player-meta-sep {
  color: #333333;
}

.player-meta-green {
  color: var(--theme);
}

.player-description-wrap {
  margin-bottom: 16rpx;
}

.player-description-text {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: #cccccc;
  line-height: 1.7;
}

.player-expand-btn {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: var(--theme);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.player-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.player-tag {
  padding: 6rpx 20rpx;
  background-color: #1a1a1a;
  border: 1px solid transparent;
}

.player-tag text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ===== 关联动态 ===== */
.player-related {
  padding: 40rpx 48rpx;
}

.player-related-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  color: #555555;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.player-related-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.related-card {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 20rpx;
  border: 1px solid #262626;
  background-color: #0a0a0a;
}

.related-img {
  width: 120rpx;
  height: 120rpx;
  border: 1px solid #262626;
  flex-shrink: 0;
  filter: grayscale(1);
}

.related-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.related-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #cccccc;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.related-platform {
  font-family: 'Courier New', Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: #555555;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* ===== 列表视图 ===== */
.list-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding: 32rpx 48rpx 16rpx;
  border-bottom: 1px solid #262626;
}

.list-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.list-count {
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  font-weight: 400;
  color: #555555;
  text-transform: uppercase;
}

.video-list {
  padding: 32rpx 48rpx;
}

.video-month {
  margin-bottom: 48rpx;
}

.video-month-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.video-month-line {
  width: 8rpx;
  height: 40rpx;
  background-color: var(--theme);
}

.video-month-title {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.video-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.video-card {
  background-color: #141414;
  border: 1px solid #262626;
  overflow: hidden;
}

.video-card-thumb {
  aspect-ratio: 16/9;
  position: relative;
  overflow: hidden;
}

.video-card-img {
  width: 100%;
  height: 100%;
  filter: grayscale(1);
  opacity: 0.7;
}

.video-card-play {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(142,216,131,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-card-play text {
  color: #000000;
  font-size: 24rpx;
  margin-left: 4rpx;
}

.video-card-duration {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.7);
  border: 1px solid #333;
  padding: 4rpx 12rpx;
}

.video-card-duration text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: #cccccc;
}

.video-card-date-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0,0,0,0.6);
  border: 1px solid #333;
  padding: 4rpx 12rpx;
}

.video-card-date-badge text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: #ffffff;
}

.video-card-info {
  padding: 24rpx;
}

.video-card-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #ffffff;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-card-desc {
  display: block;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 22rpx;
  font-weight: 400;
  font-style: italic;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.video-card-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.video-card-tag {
  padding: 4rpx 14rpx;
  background-color: #1a1a1a;
  border: 1px solid #262626;
}

.video-card-tag text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 16rpx;
  font-weight: 400;
  color: #999999;
  text-transform: uppercase;
}

.bottom-placeholder {
  height: 160rpx;
}
