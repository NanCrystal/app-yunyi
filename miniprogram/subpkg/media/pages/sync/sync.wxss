/* ── 页面容器 ── */


/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #000000;
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.custom-nav-left,
.custom-nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.nav-back-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}

.custom-nav-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 24rpx;
  color: #ffffff;
  flex: 1;
  text-align: center;
}

.page {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background: #000;
  overflow: hidden;
}

/* ── 固定 Tab 栏 ── */
.tabs-fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 101;
  height: 88rpx;
  background: rgba(0, 0, 0, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tabs-scroll {
  width: 100%;
  height: 88rpx;
  white-space: nowrap;
}

.tabs-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  gap: 8rpx;
}

.tab-item {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  transition: all 0.25s ease;
}

.tab-item--active {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-weight: 600;
}

/* ── 内容滚动区 ── */
.content-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
}

/* ── 加载 & 空状态 ── */
.loading-wrap,
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* ── 卡片列表 ── */
.feed-list {
  padding: 0 0 32rpx;
}

/* ── 卡片 ── */
.card-item {
  margin-bottom: 32rpx;
  /* background: #111; */
}

/* ── 卡片头部 ── */
.card-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  justify-content: space-between;
}
.card-header-info {
  display: flex;
  align-items: center;
 
  gap: 20rpx;
}
.card-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #222;
}

.card-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-user-row {
  display: flex;
  align-items: center;
  
}

.card-username {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.card-platform-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.card-platform-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.card-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* ── 媒体区：单张 ── */
.media-single {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.media-image {
  width: 100%;
  display: block;
  background: #1a1a1a;
  min-height: 600rpx; /* 宽度 × 0.8，防止横图过矮 */
  max-height: 940rpx; /* 宽度 × 1.25，防止竖图过高 */
  object-fit: cover; /* 配合 widthFix：超出 max-height 居中裁切 */
  object-position: center;
}

.media-video {
  width: 100%;
  height: 100%;
  background: #1a1a1a;
}

.media-image {
  width: 100%;
  display: block;
  background: #1a1a1a;
  min-height: 600rpx; /* 宽度 × 0.8，防止横图过矮 */
  max-height: 940rpx; /* 宽度 × 1.25，防止竖图过高 */
  object-fit: cover; /* 配合 widthFix：超出 max-height 居中裁切 */
  object-position: center;
}

.media-video {
  width: 100%;
  height: 100%;
  background: #1a1a1a;
}

/* 单视频锁定比例 */
.media-single.aspect-vert {
  height: 940rpx; /* 4:5 = 宽度 × 1.25 */
}

.media-single.aspect-horiz {
  height: 422rpx; /* 16:9 = 宽度 × 0.5625 */
}

.media-single.aspect-square {
  height: 750rpx; /* 1:1 */
}

/* ── 媒体区：swiper 多图 ── */
.media-swiper-wrap {
  position: relative;
  width: 100%;
  height: 940rpx; /* 锁定高度，与 swiper 一致，防止 scroll-view 场景下塌陷 */
  overflow: hidden;
}

.media-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #1a1a1a;
}

.swiper-video {
  width: 100%;
  height: 100%;
  background: #1a1a1a;
}

/* ── 渐变蒙层 + caption（已弃用，保留兼容） ── */
.card-caption-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 80rpx 32rpx 28rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
  pointer-events: none;
  z-index: 2;
}

/* ── 媒体下方 caption ── */
.card-caption-below {
  padding: 20rpx 32rpx 0;
}

/* ── caption 文字 ── */
.card-caption-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.5;
}

.card-artist-name {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.82);
  margin-right: 8rpx;
}

.card-toggle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
  flex-shrink: 0;
}

/* ── 短内容 / 展开态：自然行内流 ── */
.card-caption-line {
  line-height: 1.5;
}

/* ── 折叠态外层容器 ── */
.card-caption-collapsed {
  position: relative;
  line-height: 1.5;
}

/* ── 两行溢出截断（view 组件支持 -webkit-line-clamp） ── */
.card-caption-clamp {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  word-break: break-all;
}

/* ── 折叠态更多按钮（绝对定位右下角 + 渐变遮盖） ── */
.card-caption-collapsed > .card-toggle {
  position: absolute;
  right: 0;
  bottom: 0;
  padding-left: 24rpx;
  line-height: 1.5;
  background: linear-gradient(to right, transparent 0%, #111 40%);
}

/* 无媒体时纯文字 caption */
.card-caption-only {
  padding: 0 32rpx 32rpx;
}

.card-caption-only .card-caption-text {
  color: rgba(255, 255, 255, 0.75);
}

.card-caption-only .card-caption-collapsed > .card-toggle {
  background: linear-gradient(to right, transparent 0%, #111 40%);
}

/* ── 加载更多 ── */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.25);
}

/* ── 底部安全区 ── */
.bottom-safe {
  height: 160rpx;
}

/* ════════════════════════════════════════════
   Phase 1 · 骨架屏
   ════════════════════════════════════════════ */
.skeleton-list {
  padding: 0 0 32rpx;
}

.skeleton-card {
  margin-bottom: 32rpx;
  padding: 0 32rpx;
}

.skeleton-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.skeleton-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #1a1a1a 25%, #2a2a2a 50%, #1a1a1a 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

.skeleton-name {
  width: 160rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #1a1a1a 25%, #2a2a2a 50%, #1a1a1a 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

.skeleton-media {
  width: 100%;
  height: 940rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #1a1a1a 25%, #2a2a2a 50%, #1a1a1a 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

.skeleton-caption {
  margin-top: 20rpx;
  height: 26rpx;
  width: 60%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #1a1a1a 25%, #2a2a2a 50%, #1a1a1a 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* ════════════════════════════════════════════
   Phase 3 · swiper 视口外占位符
   ════════════════════════════════════════════ */
.swiper-placeholder {
  width: 100%;
  height: 940rpx;
  overflow: hidden;
  background: #1a1a1a;
}

/* ════════════════════════════════════════════
   Phase 4 · 视频海报 + 播放按钮
   ════════════════════════════════════════════ */
.media-poster-wrap {
  width: 100%;
  height: 100%;
  position: relative;
}

.media-poster-wrap .media-image {
  width: 100%;
  height: 100%;
  min-height: unset;
  max-height: unset;
}

.poster-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-triangle {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 16rpx 0 16rpx 28rpx;
  border-color: transparent transparent transparent rgba(255, 255, 255, 0.9);
  margin-left: 6rpx;
}
