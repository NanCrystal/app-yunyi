<view wx:if="{{visible}}" class="vp-overlay" catch:tap="onClose">
  <!-- 内容区，阻止冒泡 -->
  <view class="vp-body" catch:tap="onStopPropagation">
    <!-- 关闭按钮 -->
    <view class="vp-close" style="top: {{statusBarHeight + 22 - 24}}px;" bind:tap="onClose">
      <text class="vp-close-icon">✕</text>
    </view>

    <!-- 标题 -->
    <!-- <view class="vp-title" wx:if="{{title}}">
      <text class="vp-title-text">{{title}}</text>
    </view> -->

    <!-- 视频播放器 -->
    <view class="vp-video-wrap" bind:tap="onTogglePlay">
      <video
        id="vp-video"
        class="vp-video"
        src="{{videoUrl}}"
        poster="{{poster}}"
        object-fit="contain"
        show-center-play-btn="{{false}}"
        show-play-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        controls="{{false}}"
        bind:play="onPlay"
        bind:pause="onPause"
        bind:ended="onEnded"
        bind:timeupdate="onTimeUpdate"
      />

      <!-- 暂停时显示中央播放按钮 -->
      <view class="vp-play-overlay" wx:if="{{!isPlaying}}">
        <view class="vp-play-btn">
          <text class="vp-play-icon">▶</text>
        </view>
      </view>
    </view>

    <!-- 底部工具栏 -->
    <view class="vp-toolbar" catch:tap="onStopPropagation">
      <!-- 播放/暂停 + 进度条 -->
      <view class="vp-progress-section">
        <view class="vp-play-toggle" bind:tap="onTogglePlay">
          <text class="vp-toggle-icon">{{isPlaying ? '❚❚' : '▶'}}</text>
        </view>
        <text class="vp-time">{{currentTimeText}}</text>
        <slider
          class="vp-slider"
          min="0"
          max="100"
          step="0.1"
          value="{{progress}}"
          activeColor="var(--theme)"
          backgroundColor="rgba(255,255,255,0.2)"
          block-size="16"
          bind:change="onProgressChange"
          bind:changing="onProgressChange"
        />
        <text class="vp-time">{{durationText}}</text>
      </view>
    </view>
  </view>
</view>
