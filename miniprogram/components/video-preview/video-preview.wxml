<view wx:if="{{visible}}" class="vp-overlay" catch:tap="onClose">
  <!-- 内容区，阻止冒泡 -->
  <view class="vp-body" catch:tap="onStopPropagation">
    <!-- 关闭按钮 -->
    <view class="vp-close" bind:tap="onClose">
      <text class="vp-close-icon">✕</text>
    </view>

    <!-- 标题 -->
    <view class="vp-title" wx:if="{{title}}">
      <text class="vp-title-text">{{title}}</text>
    </view>

    <!-- 视频播放器 -->
    <view class="vp-video-wrap">
      <video
        id="vp-video"
        class="vp-video"
        src="{{videoUrl}}"
        poster="{{poster}}"
        object-fit="contain"
        show-center-play-btn="{{!isPlaying}}"
        show-play-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        controls="{{false}}"
        bind:play="onPlay"
        bind:pause="onPause"
        bind:ended="onEnded"
        bind:timeupdate="onTimeUpdate"
      />

      <!-- 自定义播放/暂停按钮（覆盖在视频上） -->
      <view class="vp-play-overlay" wx:if="{{!isPlaying}}" bind:tap="onTogglePlay">
        <view class="vp-play-btn">
          <text class="vp-play-icon">▶</text>
        </view>
      </view>
    </view>

    <!-- 底部工具栏 -->
    <view class="vp-toolbar">
      <!-- 进度条 -->
      <view class="vp-progress-section">
        <text class="vp-time">{{currentTimeText}}</text>
        <slider
          class="vp-slider"
          min="0"
          max="100"
          step="0.1"
          value="{{progress}}"
          activeColor="var(--theme)"
          backgroundColor="rgba(255,255,255,0.2)"
          block-size="16"
          bind:change="onProgressChange"
          bind:changing="onProgressChange"
        />
        <text class="vp-time">{{durationText}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="vp-actions">
        <view class="vp-action-btn" bind:tap="onDownload">
          <text class="vp-action-icon">↓</text>
          <text class="vp-action-text">下载</text>
        </view>
        <view class="vp-action-btn" bind:tap="onShare">
          <text class="vp-action-icon">↗</text>
          <text class="vp-action-text">分享</text>
        </view>
      </view>
    </view>
  </view>
</view>
