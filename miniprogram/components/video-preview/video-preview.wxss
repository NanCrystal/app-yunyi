/* ===== 视频预览 全屏覆盖 ===== */

.vp-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.vp-body {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 关闭按钮 */
.vp-close {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vp-close-icon {
  font-size: 36rpx;
  color: #ffffff;
  opacity: 0.7;
}

/* 标题 */
.vp-title {
  position: absolute;
  top: 0;
  left: 96rpx;
  right: 96rpx;
  z-index: 20;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.vp-title-text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* 视频容器 */
.vp-video-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.vp-video {
  width: 100%;
  height: 100%;
}

/* 播放按钮覆盖层 */
.vp-play-overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vp-play-btn {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
}

.vp-play-icon {
  color: #ffffff;
  font-size: 44rpx;
  margin-left: 8rpx;
}

/* 底部工具栏 */
.vp-toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
}

/* 进度条区域 */
.vp-progress-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.vp-time {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: center;
}

.vp-slider {
  flex: 1;
  margin: 0;
}

/* 操作按钮区 */
.vp-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 48rpx;
}

.vp-action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.vp-action-icon {
  font-size: 32rpx;
  color: #ffffff;
  opacity: 0.8;
}

.vp-action-text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}
