/* ===== 图片预览 全屏覆盖 ===== */

.ip-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ip-body {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 关闭按钮 */
.ip-close {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ip-close-icon {
  font-size: 36rpx;
  color: #ffffff;
  opacity: 0.7;
}

/* 图片轮播 */
.ip-swiper {
  flex: 1;
  width: 100%;
  height: 100%;
}

.ip-image {
  width: 100%;
  height: 100%;
}

/* 底部工具栏 */
.ip-toolbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
}

.ip-toolbar-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.ip-toolbar-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 40rpx;
}

/* 页码指示器 */
.ip-indicator {
  font-family: 'Courier New', Courier, monospace;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

/* 工具按钮 */
.ip-tool-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.ip-tool-icon {
  font-size: 32rpx;
  color: #ffffff;
  opacity: 0.8;
}

.ip-tool-text {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}
