/* ===== 全屏预览 ===== */
.preview-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background-color: #000000;
  display: flex;
}

/* ===== Swiper - 全屏 ===== */
.preview-swiper {
  width: 100%;
  height: 100%;
}

.preview-swiper-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 图片 - 全屏填充 ===== */
.preview-img {
  width: 100%;
  height: 100%;
}

/* ===== 操作悬浮层（固定于整体容器，不随 swiper 滑动） ===== */
.preview-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 60rpx;
  pointer-events: none;
  z-index: 10;
}

.preview-overlay .preview-info-center,
.preview-overlay .preview-actions {
  pointer-events: auto;
}

/* 居中：查看原图 + 文件大小 */
.preview-info-center {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 30rpx;
  margin-bottom: 28rpx;
}

/* 居中信息 - 锁定状态（未登录时变暗） */
.preview-info-center--locked {
  border-color: rgba(255, 255, 255, 0.06);
  background-color: rgba(0, 0, 0, 0.6);
}

.lock-icon {
   width: 28rpx;
  height: 28rpx;
  margin-right: 4rpx;
}

.preview-original-text {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 20rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.preview-size-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  /* font-weight: 400; */
  color: rgba(255, 255, 255, 0.5);
  /* letter-spacing: 1rpx; */
}

/* 按钮区：右下角固定 */
.preview-actions {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.preview-action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  background: rgba(0, 0, 0, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
}

.preview-action-btn text {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.download-icon {
  width: 28rpx;
  height: 28rpx;
}

.preview-action-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

/* （以下样式保留，供页面其他部分引用，当前预览组件已不再使用） */
.preview-info {
  padding: 48rpx;
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0.95));
  border-top: 1px solid #1a1a1a;
}

.preview-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.preview-filename {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

.preview-date {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  color: #666666;
}

.preview-title {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #ffffff;
  margin: 16rpx 0 12rpx;
}

.preview-desc {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  font-weight: 400;
  font-style: italic;
  color: #cccccc;
  display: block;
  margin-bottom: 16rpx;
}

.preview-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.preview-tag {
  padding: 6rpx 20rpx;
  background-color: #1a1a1a;
  border: 1px solid #262626;
}

.preview-tag text {
  font-family: "Courier New", Courier, monospace;
  font-size: 18rpx;
  font-weight: 400;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.preview-tag--green {
  background-color: #000000;
  border-color: rgba(142, 216, 131, 0.2);
}

.preview-tag--green text {
  color: var(--theme);
}
