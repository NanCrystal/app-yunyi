/* components/photo-skeleton/photo-skeleton.wxss */

.skeleton {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #1a1a1a;
  overflow: hidden;
}

/* ── 闪光条：从左到右扫过，模拟加载感 ── */
.skeleton__shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  /*
    用线性渐变模拟光泽：
    透明 → 半透明白 → 透明
    小程序不支持 CSS 伪元素，所以用子 view 代替
  */
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.45) 50%,
    transparent 100%
  );
  animation: skeleton-shine 1.4s ease-in-out infinite;
}

@keyframes skeleton-shine {
  0%   { left: -60%; }
  100% { left: 110%; }
}
