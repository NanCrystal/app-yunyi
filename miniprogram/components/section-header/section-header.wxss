.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1px solid #262626;
}

.section-header--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.section-title {
  font-family: "Courier New", Courier, monospace;
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: #ffffff;
}

.section-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
}

.section-more--disabled {
  pointer-events: none;
  opacity: 0.5;
}

.more-text {
  font-family: "Courier New", Courier, monospace;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--theme);
}

.more-arrow {
  width: 22rpx;
  height: 22rpx;
  background-color: var(--theme);
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}
