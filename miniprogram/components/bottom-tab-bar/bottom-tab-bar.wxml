<view class="tab-bar safe-area-bottom" style="--theme: {{themeColor}}; --theme-r: {{themeR}}; --theme-g: {{themeG}}; --theme-b: {{themeB}};">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{current === item.key ? 'tab-item--active' : ''}}"
    data-key="{{item.key}}"
    bind:tap="onTabTap"
  >
    <view class="tab-icon" wx:if="{{item.icon}}">
      <text>{{item.icon}}</text>
    </view>
    <text class="tab-label">{{item.label}}</text>
    <view wx:if="{{current === item.key}}" class="tab-indicator"></view>
  </view>
</view>
