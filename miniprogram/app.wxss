/* ===== STARVIEW ARCHIVE 全局暗色主题 ===== */

page {
  background-color: #000000;
  color: #ffffff;
  font-weight: 400;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  -webkit-font-smoothing: antialiased;
  height: 100%;
}

/* ===== 颜色变量 ===== */
/* 背景: #000000 卡片: #141414 侧面板: #0a0a0a */
/* 分割线: #262626 强分割: #3a3a3a */
/* 主文字: #ffffff 正文: #cccccc 弱文字: #999999 图标: #555555 */
/* 强调色: var(--theme)（动态主题色，跟随角色切换） */

/* ===== 通用容器 ===== */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.page-scroll {
  height: 100%;
  width: 100%;
}

/* ===== 分割线 ===== */
.hr {
  height: 1px;
  background-color: #262626;
  width: 100%;
}

/* ===== 通用 flex 布局 ===== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* ===== 文字样式 ===== */
.text-display {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  font-weight: 400;
}

.text-body {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 400;
  line-height: 1.7;
  color: #cccccc;
}

.text-mono {
  font-family: 'Courier New', Courier, monospace;
  font-weight: 400;
  text-transform: uppercase;
}

.text-muted {
  color: #999999;
}

.text-dim {
  color: #555555;
}

/* ===== 按钮 ===== */
.btn-primary {
  background: transparent;
  border: 1px solid #ffffff;
  border-radius: 9999rpx;
  color: #ffffff;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  padding: 16rpx 40rpx;
  text-transform: uppercase;
  font-weight: 400;
  font-family: 'Courier New', Courier, monospace;
}

.btn-primary:active {
  background: rgba(255, 255, 255, 0.08);
}

.btn-default {
  background: transparent;
  border: 1px solid #262626;
  border-radius: 9999rpx;
  color: #cccccc;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  text-transform: uppercase;
  font-weight: 400;
  font-family: 'Courier New', Courier, monospace;
}

.btn-default:active {
  border-color: #ffffff;
  color: #ffffff;
}

/* ===== 卡片 ===== */
.card {
  background-color: #141414;
  border: 1px solid #262626;
  border-radius: 16rpx;
}

/* ===== 隐藏滚动条 ===== */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  border: 1px dashed #262626;
}

.empty-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 22rpx;
  color: #555555;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  text-align: center;
}

/* ===== 安全区适配 ===== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

