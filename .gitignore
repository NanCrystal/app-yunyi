# ============================
# 依赖相关
# ============================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================
# 构建产物 / 编译输出
# ============================
dist/
build/
miniprogram_npm/
# TS 编译生成的 js（保留源码 .ts）
*.js
*.js.map
# 但保留 typings 目录下的类型声明文件
!typings/**

# ============================
# 微信开发者工具私有配置
# （含个人编译设置、调试条件，不应提交）
# ============================
project.private.config.json

# ============================
# 日志文件
# ============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================
# 运行时 / 缓存
# ============================
.cache/
.temp/
.tmp/
*.local

# ============================
# 编辑器 / IDE
# ============================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================
# 环境变量 / 密钥
# ============================
.env
.env.local
.env.*.local

# ============================
# 文档目录
# ============================
/doc
